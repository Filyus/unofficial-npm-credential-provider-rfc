{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filyus.github.io/unofficial-npm-credential-provider-rfc/spec/protocol-v1.schema.json",
  "title": "npm Credential Provider Protocol v1",
  "description": "Machine-readable schema for the draft npm credential provider JSONL protocol.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/providerResponse" }
  ],
  "$defs": {
    "hello": {
      "title": "Provider hello",
      "type": "object",
      "required": ["v"],
      "properties": {
        "v": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "minItems": 1,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "registries": {
          "description": "The registries this provider serves. npm matches requests against them itself (scheme compared) and sends the provider nothing about any other registry. An empty list serves none.",
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://[^/?#\\s@\\\\]+(/[^?#\\s\\\\]*)?(?![\\s\\S])" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "request": {
      "title": "Client request",
      "type": "object",
      "required": ["v", "kind", "registry"],
      "properties": {
        "v": { "const": 1 },
        "kind": {
          "description": "Open-ended so new kinds can be added within v1. A provider answers a kind it does not know with operation-not-supported and keeps serving. Known: login, logout, get, erase.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "examples": ["login", "logout", "get", "erase"]
        },
        "registry": {
          "type": "string",
          "format": "uri"
        },
        "scope": {
          "description": "The package's scope; absent for an unscoped package.",
          "type": "string",
          "pattern": "^@[^/]+(?![\\s\\S])"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "description": "The npm action the credential must authorize. The provider maps it to its own permission tier. Open-ended so new actions can be added within v1: a provider answers an operation it does not know with operation-not-supported, never as read. Known: read, publish, stage, stage-read, deprecate, dist-tag, unpublish, owner, access, trust, stage-reject, account.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "examples": ["read", "publish", "stage", "stage-read", "deprecate", "dist-tag", "unpublish", "owner", "access", "trust", "stage-reject", "account"]
        },
        "granularity": {
          "description": "erase only: the granularity of the Ok response that carried the rejected credential, so the provider can tell which of its credentials was rejected.",
          "enum": ["registry", "scope", "package"]
        },
        "command": {
          "description": "Informational npm command name. Open-ended: policy knownCommands lists examples, and providers must accept other values.",
          "type": "string",
          "minLength": 1
        },
        "interactive": {
          "type": "boolean"
        },
        "retry": {
          "type": "boolean"
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "authChallenges": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "get" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["operation", "interactive"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "erase" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["operation", "granularity"]
          }
        },
        {
          "if": {
            "properties": { "operation": { "enum": ["publish", "stage", "stage-reject"] } },
            "required": ["operation"]
          },
          "then": {
            "required": ["version"]
          }
        },
        {
          "if": {
            "properties": { "retry": { "const": true } },
            "required": ["retry"]
          },
          "then": {
            "required": ["httpStatus"]
          }
        }
      ],
      "additionalProperties": true
    },
    "providerResponse": {
      "title": "Provider response",
      "type": "object",
      "oneOf": [
        {
          "required": ["Ok"],
          "not": { "required": ["Err"] }
        },
        {
          "required": ["Err"],
          "not": { "required": ["Ok"] }
        }
      ],
      "properties": {
        "Ok": { "$ref": "#/$defs/providerOk" },
        "Err": { "$ref": "#/$defs/providerErr" }
      },
      "additionalProperties": true
    },
    "providerOk": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "description": "Must equal the request's kind. Open, as request kinds are: a newer client may add a kind within v1.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "examples": ["login", "logout", "get", "erase"]
        },
        "auth": { "$ref": "#/$defs/auth" },
        "cache": {
          "description": "Open: an unknown value is read as never.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "examples": ["never", "session", "expires"]
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operationIndependent": {
          "description": "Default false: the answer serves only the operation it was issued for.",
          "type": "boolean",
          "default": false
        },
        "granularity": {
          "description": "Open: an unknown value is read as package.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "examples": ["registry", "scope", "package"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "cache": { "const": "expires" } },
            "required": ["cache"]
          },
          "then": {
            "required": ["expiresAt"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "get" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["auth"]
          }
        }
      ],
      "additionalProperties": true
    },
    "auth": {
      "oneOf": [
        { "$ref": "#/$defs/bearerAuth" },
        { "$ref": "#/$defs/basicAuth" },
        { "$ref": "#/$defs/unknownAuth" }
      ]
    },
    "bearerAuth": {
      "type": "object",
      "required": ["type", "token"],
      "properties": {
        "type": { "const": "bearer" },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "basicAuth": {
      "type": "object",
      "required": ["type", "username", "password"],
      "properties": {
        "type": { "const": "basic" },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "unknownAuth": {
      "description": "An auth.type this version does not know: npm has nothing it can send, so it fails the request as an other answer naming the provider.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "not": { "enum": ["bearer", "basic"] }
        }
      },
      "additionalProperties": true
    },
    "providerErr": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "description": "Open: an unknown value is read as other.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "examples": ["url-not-supported", "not-found", "operation-not-supported", "other"]
        },
        "message": {
          "type": "string"
        },
        "causedBy": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  }
}
