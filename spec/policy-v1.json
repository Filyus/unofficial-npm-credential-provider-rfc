{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocolVersion": 1,
  "wire": {
    "requestKinds": [
      "login",
      "logout",
      "get",
      "erase"
    ],
    "operations": [
      "read",
      "publish",
      "stage",
      "stage-read",
      "deprecate",
      "dist-tag",
      "unpublish",
      "owner",
      "access",
      "trust",
      "stage-reject",
      "account"
    ],
    "operationsRequiringVersion": [
      "publish",
      "stage",
      "stage-reject"
    ],
    "knownCommands": [
      "install",
      "ci",
      "publish",
      "search",
      "view"
    ],
    "capabilities": [
      "login",
      "logout",
      "erase",
      "auth-challenges",
      "retry-context"
    ],
    "authTypes": [
      "bearer",
      "basic"
    ],
    "cachePolicies": [
      "never",
      "session",
      "expires"
    ],
    "granularities": [
      "registry",
      "scope",
      "package"
    ],
    "errorKinds": [
      "url-not-supported",
      "not-found",
      "operation-not-supported",
      "other"
    ]
  },
  "forwardCompatibility": {
    "identifierPattern": "^[a-z][a-z0-9-]*$",
    "unknownRequestKind": "operation-not-supported",
    "unknownOperation": "operation-not-supported",
    "unknownFields": "ignore",
    "unknownCapabilities": "ignore",
    "unknownErrorKind": "other",
    "unknownCache": "never",
    "unknownGranularity": "package",
    "unknownAuthType": "fail-as-other-naming-the-provider"
  },
  "errors": {
    "url-not-supported": {
      "default": "try-next-provider",
      "erase": "ignore-and-retry"
    },
    "not-found": {
      "default": "try-next-provider-not-found",
      "erase": "ignore-and-retry"
    },
    "operation-not-supported": {
      "default": "fail",
      "erase": "ignore-and-retry"
    },
    "other": {
      "default": "fail",
      "erase": "warn-and-retry"
    }
  },
  "fallback": {
    "noProviderConfigured": "stored-credential-or-anonymous",
    "globalChainAllUrlNotSupported": "stored-credential-or-anonymous-with-warning",
    "globalChainAllUrlNotSupportedOnListedHost": "fail",
    "globalChainWarningLimitedToListedHostsWhenEveryProviderListsRegistries": true,
    "registryChainAllUrlNotSupported": "fail",
    "registryChainIgnoresStoredCredential": "warn",
    "notFoundAtEnd": "fail",
    "notFoundAtEndWithLegacyFallback": "stored-credential-or-anonymous",
    "noCommonVersion": "fail",
    "noCommonVersionWithLegacyFallback": "as-not-found",
    "otherFailure": "fail",
    "otherFailureWithLegacyFallback": "fail"
  },
  "chain": {
    "notFound": "try-next-provider",
    "urlNotSupportedRemembered": "per-provider-and-registry-for-the-command",
    "notFoundRemembered": "per-provider-registry-and-scope-for-the-command",
    "storedCredentialEntry": "npm:token",
    "implicitStoredCredentialEntry": "end-of-global-chain-unless-a-provider-answered-not-found",
    "builtinPrefix": "npm:",
    "unknownBuiltin": "fail",
    "loginAndLogout": "as-get-listed-npm-token-runs-npm-login",
    "oidcExchangedToken": "asks-no-provider"
  },
  "resolution": {
    "allowedConfigSources": [
      "user",
      "global"
    ],
    "trustedLocationKinds": [
      "builtin",
      "absolute",
      "global-bin"
    ],
    "untrustedLocationKinds": [
      "project-node_modules",
      "cwd",
      "path"
    ],
    "ambiguousTrustedProvider": "fail",
    "missingProvider": "fail"
  },
  "tokenHelper": {
    "allowedConfigSources": [
      "user",
      "global"
    ],
    "absolutePathOnly": true,
    "arguments": false,
    "timeoutSeconds": 60,
    "runsPerRegistryPerProcess": 1,
    "emptyOutput": "fail",
    "nonZeroExit": "fail"
  },
  "credentialProvider": {
    "timeoutSeconds": {
      "hello": 10,
      "get": 30,
      "getInteractive": 300,
      "erase": 10,
      "login": 300,
      "logout": 30
    },
    "timeoutKillsBeforeNoRestart": 2,
    "queuedAfterTimeout": "fail",
    "cacheAfterTimeout": "keep",
    "sentinelArgument": "--npm-credential-provider"
  },
  "cache": {
    "defaultPolicy": "session",
    "defaultGranularity": "registry",
    "expiresRequires": [
      "expiresAt"
    ],
    "expiryMarginSeconds": 60,
    "operationIndependentDefault": false,
    "storePolicies": [
      "session",
      "expires"
    ],
    "doNotStorePolicies": [
      "never"
    ],
    "operationBoundExcept": [
      "read"
    ],
    "packageBoundWhenPresent": true,
    "schemeInKey": true
  },
  "nonInteractive": {
    "interactiveFalseAllowsPrompts": false,
    "ciRequiresPreconfiguredTrust": true,
    "missingCredentialBehavior": "fail",
    "interactiveRule": "stdin and stdout are TTYs and no CI is detected"
  },
  "limits": {
    "lineSize": "implementation-defined",
    "oversizeBehavior": "fail",
    "lineSizeMinimum": 1048576
  },
  "rejection": {
    "401": "erase-and-retry",
    "401-otp": "otp-prompt",
    "401-ipaddress": "eauthip",
    "403": "retry-without-erase",
    "retriesPerRequest": 1,
    "appliesTo": "provider credentials; npm:token and OIDC credentials get no erase and no provider retry"
  }
}
