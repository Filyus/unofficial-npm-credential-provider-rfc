{
  "hosts": [
    "https://accounts.google.com",
    "https://oauth2.googleapis.com",
    "https://iamcredentials.googleapis.com",
    "https://sts.googleapis.com"
  ],
  "now": 1792231800,
  "config": {
    "repositories": {
      "https://us-central1-npm.pkg.dev/acme-prod/npm-all/": {
        "read": {
          "serviceAccount": "acme-reader@acme-prod.iam.gserviceaccount.com",
          "lifetime": 1800
        }
      },
      "https://us-central1-npm.pkg.dev/acme-prod/npm-private/": {
        "read": {
          "serviceAccount": "acme-reader@acme-prod.iam.gserviceaccount.com",
          "lifetime": 1800
        },
        "write": {
          "serviceAccount": "acme-writer@acme-prod.iam.gserviceaccount.com",
          "lifetime": 1200
        }
      }
    },
    "adc": "fixtures/ci-adc.json",
    "clientSecret": "example-desktop-client-secret"
  },
  "presence": [
    true
  ],
  "store": {
    "gcloud": {
      "adc": {
        "refreshToken": "refresh-adc-1"
      }
    }
  },
  "state": {
    "oauth": {
      "account": "dev@example.test",
      "sessions": {
        "refresh-adc-1": {
          "account": "dev@example.test"
        }
      },
      "clientSecret": "example-desktop-client-secret"
    },
    "iam": {
      "serviceAccounts": {
        "acme-reader@acme-prod.iam.gserviceaccount.com": {
          "roles": [
            "roles/artifactregistry.reader"
          ],
          "tokenCreators": [
            "dev@example.test"
          ],
          "tokens": [
            "example-reader-token"
          ]
        },
        "acme-writer@acme-prod.iam.gserviceaccount.com": {
          "roles": [
            "roles/artifactregistry.writer"
          ],
          "tokenCreators": [
            "dev@example.test"
          ],
          "tokens": [
            "example-writer-token"
          ]
        }
      }
    }
  },
  "expect": {
    "state": {
      "oauth": {
        "refreshes": 1
      },
      "iam": {
        "issued": [
          {
            "principal": "acme-writer@acme-prod.iam.gserviceaccount.com",
            "roles": [
              "roles/artifactregistry.writer"
            ],
            "lifetime": 1200
          }
        ]
      },
      "sts": {
        "issued": []
      }
    }
  },
  "env": {
    "CI": "true"
  }
}
