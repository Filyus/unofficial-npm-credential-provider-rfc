+
+// A registry may echo the credential it was sent in an error body or a header,
+// and npm prints and logs the error. The header npm sent on the request is
+// known exactly, so it is hidden, in the forms scrub() knows, from the fields
+// of an HTTP error that are shown: the message, the body (parsed or as bytes)
+// and the headers. The error keeps its class and its other fields.
+const redact = (value, authorization) => {
+  if (typeof value === 'string') {
+    return scrub(value, authorization)
+  }
+  if (Buffer.isBuffer(value)) {
+    const text = value.toString('utf8')
+    const hidden = scrub(text, authorization)
+    return hidden === text ? value : Buffer.from(hidden)
+  }
+  if (Array.isArray(value)) {
+    return value.map(item => redact(item, authorization))
+  }
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.entries(value)
+      .map(([key, item]) => [scrub(key, authorization), redact(item, authorization)]))
+  }
+  return value
