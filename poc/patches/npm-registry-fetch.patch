+  Object.fromEntries(Object.entries(env)
+    .filter(([name]) => !NPM_SET.test(name))
+    .map(([name, value]) => [name, /^path$/i.test(name) ? withoutScriptPaths(value, delimiter, cwd) : value]))
+
+// Stops a helper that outlived its deadline, or that printed too much. SIGTERM
+// first, so a helper that cleans up can; SIGKILL if it ignores that. Windows
+// has no signals, and the real helper behind a .cmd wrapper is a grandchild of
+// cmd.exe, which terminating cmd.exe alone would leave running, so the whole
+// tree goes while the helper runs; a background process it started and left
+// behind when it exited belongs to no tree any more and is not reached.
+// Elsewhere only the helper process itself is signalled, as in
+// pnpm: reaching its children would mean starting it in a session of its own,
+// which would cost it the terminal a helper may prompt on and the Ctrl-C aimed
+// at npm. A helper script should therefore `exec` the command that does the
+// work.
+const killTree = (child, platform, spawn = execFile, grace = GRACE) => {
+  if (child.exitCode !== null || child.signalCode !== null) {
+    return
+  }
+  if (platform === 'win32') {
+    const taskkill = path.win32.join(process.env.SystemRoot || 'C:\\Windows', 'System32', 'taskkill.exe')
+    try {
+      spawn(taskkill, ['/pid', String(child.pid), '/T', '/F'], { windowsHide: true }, () => {})
+    } catch {
+      child.kill()
+    }
+    return
+  }
+  child.kill('SIGTERM')
+  const timer = setTimeout(() => child.kill('SIGKILL'), grace)
+  child.once('exit', () => clearTimeout(timer))
+}
+
+// The deadline is our own timer, not execFile's `timeout`: that sends one
+// SIGTERM and then waits for the process to close, so a helper that ignores
+// it would leave this promise pending (and cached) forever, and one that
+// prints a token and exits 0 after the deadline would succeed. The promise
+// settles at the deadline whatever the process does, and a result that
+// arrives later is ignored.
+//
+// The output limit is counted here too rather than left to execFile's
+// `maxBuffer`: execFile ends the helper with child.kill(), which on Windows
+// reaches cmd.exe only and leaves the helper behind a .cmd wrapper running,
+// and once cmd.exe is gone taskkill can no longer find the tree. So execFile
+// gets no limit, and an overflow ends the whole tree, stops reading, and
+// settles the promise at that moment.
+const run = (helper, timeout, spawn = execFile, platform = process.platform) =>
+  new Promise((resolve, reject) => {
+    // a path command() refuses throws here, which rejects the promise
+    const { file, args, verbatim, cwd } = command(helper, platform)
+    let child
+    let overflowed = false
+    try {
+      child = spawn(file, args, {
+        cwd,
+        env: helperEnv(process.env),
+        windowsHide: true,
+        windowsVerbatimArguments: verbatim,
+        // bytes, counted as the helper wrote them and decoded once at the end
+        encoding: 'buffer',
+        maxBuffer: Infinity,
+      }, (err, out, errOut) => {
+        clearTimeout(timer)
+        clearTimeout(drain)
+        const [stdout, stderr] = [out, errOut].map(b => b.toString('utf8'))
+        // a flood of up to a megabyte is not shown, line by line, after the
+        // error that reported it, and the token it might echo is not known
+        if (overflowed) {
+          return
+        }
