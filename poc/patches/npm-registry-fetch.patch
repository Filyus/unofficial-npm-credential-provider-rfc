+// A registry that echoes the Authorization it was sent in an error. The
+// helper's credential is known exactly, so what npm shows or logs of the error
+// (message, body, headers) does not have it, in the forms stderr masking hides.
+const ECHOED = 's3cr"et+/&\\z9'
+const ECHOED_FORMS = {
+  raw: ECHOED,
+  json: JSON.stringify(ECHOED).slice(1, -1),
+  percent: encodeURIComponent(ECHOED),
+}
+const shown = (value) => [JSON.stringify(value), String(value)].join('\n')
+const leaks = (value) => {
+  const text = shown(value)
+  return Object.entries(ECHOED_FORMS)
+    .filter(([, form]) => text.includes(form) || text.includes(JSON.stringify(form).slice(1, -1)))
+    .map(([name]) => name)
+}
+const failing = async (t, reply, opts = {}) => {
+  const helper = makeHelper(t, print(ECHOED))
+  const logs = logsOf(t)
