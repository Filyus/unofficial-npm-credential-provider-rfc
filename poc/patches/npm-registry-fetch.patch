diff --git a/lib/token-helper.js b/lib/token-helper.js
new file mode 100644
index 0000000..dc079da
--- /dev/null
+++ b/lib/token-helper.js
@@ -0,0 +1,526 @@
+'use strict'
+
+const { execFile } = require('child_process')
+const fs = require('fs')
+const path = require('path')
+const { log } = require('proc-log')
+
+// A token helper is an executable that prints a registry credential to stdout.
+// The semantics match pnpm's `tokenHelper`, so one helper serves both clients:
+// a raw token is sent as a Bearer token, and output that already starts with
+// an auth scheme (`Bearer ...`, `Basic ...`) is used as the header value.
+// Restricting the setting to user and global config is the config layer's
+// job; this module only refuses anything that is not an absolute path.
+
+const TIMEOUT = 60 * 1000
+// how long a helper that ignores SIGTERM gets before it is killed outright
+const GRACE = 2 * 1000
+const MAX_BUFFER = 1024 * 1024
+// how long stdout and stderr may still deliver after the helper has exited:
+// a background process it started can hold them open indefinitely
+const DRAIN = 250
+// the longest working directory Windows starts a program in
+const MAX_WIN_CWD = 258
+
+// At most one run per helper and registry for the life of the process, and a
+// failed run counts: it is cached like a success, so a broken helper is not
+// started again for every request of an install.
+const cache = new Map()
+
+// A value that is refused is not known to be a path: it can be a credential
+// pasted into the setting, or a command with its arguments (`aws ... --token
+// abc`), and the message is printed and logged. Only what comes before the
+// first whitespace is shown, and of a word that is not a path (no separator in
+// it) only the start, so that a token pasted whole is not echoed either.
+const display = (value) => {
+  if (typeof value !== 'string') {
+    return `<${typeof value}>`
+  }
+  const word = value.split(/\s/)[0]
+  return /[\\/]/.test(word) || word.length <= 6 ? word : `${word.slice(0, 3)}\u2026`
+}
+
+class TokenHelperError extends Error {
+  // `cause` is limited to a code and a signal by the callers: the errors
+  // execFile produces carry the helper's stdout, stderr and command line, and
+  // stdout is the credential
+  constructor (helper, message, cause) {
+    super(`Token helper ${JSON.stringify(helper)} ${message}`, { cause })
+    this.code = 'ETOKENHELPER'
+    this.helper = helper
+  }
+}
+
+// What the helper printed, without the whitespace around it. trim() also
+// removes a leading U+FEFF, which Windows PowerShell 5.1 puts in front of
+// UTF-8 output; a leading space would otherwise turn into `Bearer  tok`.
+const clean = (stdout) => stdout.trim()
+
+const toHeader = (helper, stdout) => {
+  const token = clean(stdout)
+  if (!token) {
+    throw new TokenHelperError(helper, 'printed an empty token')
+  }
+  // a second line, a control character or anything outside ASCII would make
+  // Headers throw an error that quotes the whole value, credential included,
+  // and npm prints and logs that error; refused here without quoting it
+  if (/[^\t\x20-\x7e]/.test(token)) {
+    throw new TokenHelperError(helper, 'printed something that is not a valid header value ' +
+      '(more than one line, a control character or a non-ASCII character)')
+  }
+  return /^[A-Za-z]+ /.test(token) ? token : `Bearer ${token}`
+}
+
+// Why execFile failed, in words for the user. `err.message` is used only for
+// failures to start, where it is "spawn <path> ENOENT" and never contains
+// output; for a non-zero exit it is "Command failed: <path>\n<stderr>".
+const reason = (err) => {
+  if (err.signal) {
+    return `was killed by ${err.signal}`
+  }
+  if (err.code === 127 || err.code === 9009) {
+    // a shell's and cmd.exe's status for a command that was not found
+    return `exited with status ${err.code}, which a shell gives when a command it runs is not found; ` +
+      'npm takes the node_modules/.bin directories it added for a script out of the helper\'s PATH, ' +
+      'so a tool installed in a project has to be called by its absolute path'
+  }
+  if (typeof err.code === 'number') {
+    return `exited with status ${err.code}`
+  }
+  return `could not be run: ${err.message}`
+}
+
+// A script whose #! interpreter is missing fails to start with ENOENT, the
+// same as a helper that is not there: CRLF line endings make it look for
+// `/bin/sh\r`, and `#!/usr/local/bin/node` misses a Homebrew node in
+// /opt/homebrew. Only the #! line is read, never anything the helper printed.
+const interpreter = (helper) => {
+  let line
+  let fd
+  try {
+    fd = fs.openSync(helper, 'r')
+    const head = Buffer.alloc(256)
+    line = head.subarray(0, fs.readSync(fd, head, 0, 256, 0)).toString().split('\n')[0]
+  } catch {
+    return null
+  } finally {
+    if (fd !== undefined) {
+      fs.closeSync(fd)
+    }
+  }
+  if (!line.startsWith('#!')) {
+    return null
+  }
+  return `could not be run: its interpreter ${JSON.stringify(line.slice(2).trim())} was not found` +
+    (line.endsWith('\r') ? ' (the #! line ends in a carriage return: the file has Windows line endings)' : '')
+}
+
+const failure = (helper, err) => new TokenHelperError(helper,
+  (err.code === 'ENOENT' && interpreter(helper)) || reason(err), {
+    code: err.code,
+    signal: err.signal,
+  })
+
+// The ways a helper that echoes its credential may write it besides as it is:
+// as JSON does (a quote or a backslash escaped, and in ASCII, every other
+// character as \uXXXX), inside a shell's single quotes, which `set -x` prints
+// (a quote as '\''), inside its double quotes, and percent-encoded as a URL
+// has it. The hexadecimal digits of an escape come in both cases, as encoders
+// differ (`\u001b` and `\u001B`, `%2b` and `%2B`). A credential made of
+// letters, digits and `-._~` is written the same way in all of them.
+const written = (secret) => {
+  const json = JSON.stringify(secret).slice(1, -1)
+  // eslint-disable-next-line no-control-regex
+  const ascii = json.replace(/[^\x20-\x7e]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, '0')}`)
+  const forms = [
+    secret,
+    json,
+    ascii,
+    ascii.replace(/\\u[0-9a-f]{4}/g, (escape) => escape.toUpperCase().replace('\\U', '\\u')),
+    secret.replace(/'/g, "'\\''"),
+    secret.replace(/["$`\\]/g, '\\$&'),
+  ]
+  try {
+    const encoded = encodeURIComponent(secret)
+    // encodeURIComponent leaves ! ' ( ) * alone and RFC 3986 does not
+    const strict = encoded.replace(/[!'()*]/g, (c) => `%${c.charCodeAt(0).toString(16).toUpperCase()}`)
+    for (const form of [encoded, strict]) {
+      forms.push(form, form.replace(/%[0-9A-F]{2}/g, (escape) => escape.toLowerCase()))
+    }
+  } catch {
+    // a lone surrogate cannot be encoded; the text a helper printed has none
+  }
+  return forms
+}
+
+// stderr is the helper's channel to the user, but a helper that fails or runs
+// with `set -x` is likely to echo the credential it handles. Two layers mask it.
+//
+// scrub() removes the helper's own token wherever it appears, in any form
+// (raw, in JSON, on the line after `Authorization:`): it is the one value that
+// is known exactly. It runs on the whole of stderr, before the lines are split,
+// and also covers the part after a scheme, so `Bearer tok` hides `tok` too.
+// Output that is refused (a second line, an ANSI reset, a NUL, an accented or
+// invalid byte next to the token) never appears whole in stderr, so each
+// longer run of printable ASCII in it is hidden as well.
+const scrub = (text, stdout) => {
+  const token = clean(stdout)
+  // eslint-disable-next-line no-control-regex
+  const runs = token.replace(/\x1b\[[0-9;]*[A-Za-z]/g, ' ').split(/[^\x21-\x7e]+/).filter(r => r.length >= 8)
+  const secrets = new Set([token, token.replace(/^[A-Za-z]+\s+/, ''), ...runs].filter(Boolean).flatMap(written))
+  // longest first, so that a form that contains another is hidden whole
+  for (const secret of [...secrets].sort((a, b) => b.length - a.length)) {
+    text = text.split(secret).join('***')
+  }
+  return text
