 lib/auth.js  |  65 +++++++++++++++++++--
 lib/index.js |  48 +++++++++++++---
 test/auth.js | 159 +++++++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 291 insertions(+), 13 deletions(-)

diff --git a/README.md b/README.md
index f474cdc..0534136 100644
--- a/README.md
+++ b/README.md
@@ -263,6 +263,38 @@ If present, other auth-related values in `opts` will be completely ignored,
 including `alwaysAuth`, `email`, and `otp`, when calculating auth for a request,
 and the auth details in `opts.forceAuth` will be used instead.
 
+##### <a name="opts-getAuthorization"></a> `opts.getAuthorization`
+
+* Type: `async ({ regKey, uri }) => string | undefined`
+* Default: null
+
+Called with an object holding a registry key (`//<host>[:<port>]/<path>/`) and
+the URL of the request, to supply the value of the `Authorization` header from
+somewhere other than the options, for example from a program the caller runs.
+It is an object so that fields can be added later without breaking callers.
+It is asked for the keys a stored credential for the request would be looked up
+under (the request's URL from the longest key up, then the registry's keys for a
+URL on the registry's host), and the first value returned is sent as the header.
+For a key that also has a stored credential, the returned value wins. The walk
+stops at a key that holds a stored credential which sets `Authorization` (a
+token, `_auth`, or a username and password); a key that holds only a client
+certificate and key does not stop it. The request is otherwise sent exactly as
+it is for a stored `_authToken`. An error thrown by the function rejects the
+request as it is. It is not called for an `opts.offline` request, nor when
+[`opts.forceAuth`](#opts-forceAuth) is set. This library runs nothing itself.
+
+A caller that must not run without the option being honoured (a version older
+than the one that added it ignores it) can check `getAuth.supportsGetAuthorization`,
+which is `true` where it is.
+
+```
+{
+  getAuthorization: async ({ regKey }) => regKey === '//npm.corp.example.com/'
+    ? `Bearer ${await fetchToken()}`
+    : undefined
+}
+```
+
 ##### <a name="opts-gzip"></a> `opts.gzip`
 
 * Type: Boolean
diff --git a/lib/auth.js b/lib/auth.js
index 9270025..876efe5 100644
--- a/lib/auth.js
+++ b/lib/auth.js
@@ -6,25 +6,31 @@ const { URL } = require('url')
 // Find the longest registry key that is used for some kind of auth
 // in the options.  Returns the registry key and the auth config.
 const regFromURI = (uri, opts) => {
-  const parsed = new URL(uri)
   // try to find a config key indicating we have auth for this registry
   // can be one of :_authToken, :_auth, :_password and :username, or
   // :certfile and :keyfile
-  // We walk up the "path" until we're left with just //<host>[:<port>],
-  // stopping when we reach '//'.
-  let regKey = `//${parsed.host}${parsed.pathname}`
-  while (regKey.length > '//'.length) {
+  for (const regKey of regKeys(uri)) {
     const authKey = hasAuth(regKey, opts)
     // got some auth for this URI
     if (authKey) {
       return { regKey, authKey }
     }
+  }
+  return { regKey: false, authKey: null }
+}
 
+// The registry keys a URI can be configured under, longest first. We walk up
+// the "path" until we're left with just //<host>[:<port>], stopping when we
+// reach '//'.
+function * regKeys (uri) {
+  const parsed = new URL(uri)
+  let regKey = `//${parsed.host}${parsed.pathname}`
+  while (regKey.length > '//'.length) {
+    yield regKey
     // can be either //host/some/path/:_auth or //host/some/path:_auth
     // walk up by removing EITHER what's after the slash OR the slash itself
     regKey = regKey.replace(/([^/]+|\/)$/, '')
   }
-  return { regKey: false, authKey: null }
 }
 
 // Not only do we want to know if there is auth, but if we are calling `npm
@@ -49,6 +55,13 @@ const hasAuth = (regKey, opts) => {
   return false
 }
 
+// Whether the options hold a stored credential under `regKey` that sets the
+// Authorization header; a certificate and key alone do not.
+const setsAuthorization = (regKey, opts) => {
+  const authKey = hasAuth(regKey, opts)
+  return Boolean(authKey) && authKey !== 'certfile'
+}
+
 const sameHost = (a, b) => {
   const parsedA = new URL(a)
   const parsedB = new URL(b)
@@ -178,4 +191,44 @@ class Auth {
   }
 }
 
+// Asks `opts.getAuthorization({ regKey, uri })` for a header value under the
+// registry keys a stored credential for `uri` would be looked up under: the
+// keys of the URI from the longest up, then, for a URI on the registry's own
+// host (a tarball), the keys of the registry. The first key for which the
+// function returns a value wins. The walk ends at the first key that holds a
+// stored credential which sets Authorization (a token, `_auth`, or a username
+// and password), so a function wins over a stored credential for the same key,
+// and a credential stored under a longer key wins over a function's for a
+// shorter one. A key that holds only a client certificate and key (mTLS) sets
+// no Authorization and does not end the walk. Resolves to undefined when there
+// is no function, when the request brings its own `forceAuth`, or when no key
+// has a value.
+const authorize = async (uri, opts) => {
+  const { getAuthorization, forceAuth } = opts
+  if (typeof getAuthorization !== 'function' || forceAuth) {
+    return undefined
+  }
+  const registry = getRegistry(opts)
+  const keys = new Set(regKeys(uri))
+  if (registry && uri !== registry && sameHost(uri, registry)) {
+    for (const key of regKeys(registry)) {
+      keys.add(key)
+    }
+  }
+  for (const regKey of keys) {
+    const value = await getAuthorization({ regKey, uri })
+    if (value) {
+      return value
+    }
+    if (setsAuthorization(regKey, opts)) {
+      break
+    }
+  }
+  return undefined
+}
+
 module.exports = getAuth
+module.exports.authorize = authorize
+// What a caller checks to know the library it was handed serves
+// opts.getAuthorization; an older one ignores the option without a word
+module.exports.supportsGetAuthorization = true
diff --git a/lib/index.js b/lib/index.js
index 91d450f..4dafec3 100644
--- a/lib/index.js
+++ b/lib/index.js
@@ -3,6 +3,7 @@
 const { HttpErrorAuthOTP } = require('./errors.js')
 const checkResponse = require('./check-response.js')
 const getAuth = require('./auth.js')
+const { authorize } = getAuth
 const fetch = require('make-fetch-happen')
 const JSONStream = require('./json-stream')
 const npa = require('npm-package-arg')
@@ -71,12 +72,8 @@ function regFetch (uri, /* istanbul ignore next */ opts_ = {}) {
 
   if (opts.gzip) {
     headers['content-encoding'] = 'gzip'
-    if (bodyIsStream) {
-      const gz = new zlib.Gzip()
-      body.on('error', /* istanbul ignore next: unlikely and hard to test */
-        err => gz.emit('error', err))
-      body = body.pipe(gz)
-    } else if (!bodyIsPromise) {
+    // a stream is piped into gzip only when the request is about to be sent
+    if (!bodyIsStream && !bodyIsPromise) {
       body = new zlib.Gzip().end(body).concat()
     }
   }
@@ -164,7 +161,44 @@ function regFetch (uri, /* istanbul ignore next */ opts_ = {}) {
     }
   }
 
-  return Promise.resolve(body).then(doFetch)
+  const send = () => {
+    if (opts.gzip && bodyIsStream) {
+      const gz = new zlib.Gzip()
+      body.on('error', /* istanbul ignore next: unlikely and hard to test */
+        err => gz.emit('error', err))
+      body = body.pipe(gz)
+    }
+    return Promise.resolve(body).then(doFetch)
+  }
+
+  // an offline request makes no network request, so there is nothing to
+  // authenticate and opts.getAuthorization is not asked
+  if (typeof opts.getAuthorization !== 'function' || opts.offline) {
+    return send()
+  }
+  return getAuthorization(authorize(uri, opts), body, bodyIsStream).then(authorization => {
+    if (authorization) {
+      headers.authorization = authorization
+    }
+    return send()
+  })
+}
+
+// opts.getAuthorization can take a while (a program may run) and the request
+// is not sent until it is done. Whatever the caller handed over in the
+// meantime has to be watched, or its failure goes unhandled: a body promise
+// that rejects is an unhandled rejection, and a stream that errors with no
+// listener throws (which is why the gzip pipeline is built after the wait).
+// An error from the function itself rejects the request as it is.
+function getAuthorization (pending, body, bodyIsStream) {
+  const failed = new Promise((resolve, reject) => {
+    if (bodyIsStream) {
+      body.on('error', reject)
+    } else if (body && typeof body.then === 'function') {
+      Promise.resolve(body).catch(reject)
+    }
+  })
+  return Promise.race([pending, failed])
 }
 
 module.exports.getAuth = getAuth
diff --git a/test/auth.js b/test/auth.js
index ac65822..ee3c816 100644
--- a/test/auth.js
+++ b/test/auth.js
@@ -1,6 +1,7 @@
 'use strict'
 
 const t = require('tap')
+const { Minipass } = require('minipass')
 const tnock = require('./util/tnock.js')
 
 const fetch = require('..')
@@ -619,3 +620,161 @@ t.test('registry host matches, path does not, send auth', t => {
 t.test('getAuth is exported', async t => {
   t.equal(fetch.getAuth, getAuth)
 })
+
+t.test('getAuth says it serves opts.getAuthorization', async t => {
+  t.equal(getAuth.supportsGetAuthorization, true)
+})
+
+t.test('opts.getAuthorization', async t => {
+  const calls = []
+  const answers = {}
+  const uris = []
+  const getAuthorization = async ({ regKey, uri }) => {
+    calls.push(regKey)
+    uris.push(uri)
+    return answers[regKey]
+  }
+  const reg = 'https://mock.reg/prefix/'
+  const base = { ...OPTS, registry: reg, getAuthorization }
+  const reply = (t, expected, path = '/prefix/hello') => tnock(t, 'https://mock.reg')
+    .matchHeader('authorization', v => (v ? v[0] : undefined) === expected)
+    .get(path)
+    .reply(200, '"ok"')
+  t.beforeEach(() => {
+    calls.length = 0
+    uris.length = 0
+    for (const k of Object.keys(answers)) {
+      delete answers[k]
+    }
+  })
+
+  await t.test('is asked for the keys a stored credential would match, longest first', async t => {
+    reply(t, undefined)
+    t.equal(await fetch.json('/hello', base), 'ok')
+    t.strictSame(calls, ['//mock.reg/prefix/hello', '//mock.reg/prefix/', '//mock.reg/prefix', '//mock.reg/', '//mock.reg'])
+  })
+
+  await t.test('is given an object with the key and the URL of the request', async t => {
+    reply(t, undefined)
+    await fetch.json('/hello', base)
+    t.strictSame(uris, Array(5).fill('https://mock.reg/prefix/hello'))
+  })
+
+  await t.test('an mTLS pair at a longer key does not shadow the function at a shorter one', async t => {
+    const dir = t.testdir({ 'my.cert': 'my cert', 'my.key': 'my key' })
+    answers['//mock.reg/'] = 'Bearer fromfn'
+    reply(t, 'Bearer fromfn')
+    await fetch.json('/hello', {
+      ...base,
+      '//mock.reg/prefix/:certfile': `${dir}/my.cert`,
+      '//mock.reg/prefix/:keyfile': `${dir}/my.key`,
+    })
+    t.strictSame(calls, ['//mock.reg/prefix/hello', '//mock.reg/prefix/', '//mock.reg/prefix', '//mock.reg/'], 'the walk went past the pair')
+    t.strictSame(calls.slice(-1), ['//mock.reg/'], 'and stopped at the function\'s value')
+  })
+
+  await t.test('the value is the header, as is', async t => {
+    answers['//mock.reg/prefix/'] = 'Basic dXNlcjpwYXNz'
+    reply(t, 'Basic dXNlcjpwYXNz')
+    t.equal(await fetch.json('/hello', base), 'ok')
+    t.strictSame(calls, ['//mock.reg/prefix/hello', '//mock.reg/prefix/'], 'stops at the first value')
+  })
+
+  await t.test('wins over a stored token for the same key', async t => {
+    answers['//mock.reg/prefix/'] = 'Bearer fromfn'
+    reply(t, 'Bearer fromfn')
+    await fetch.json('/hello', { ...base, '//mock.reg/prefix/:_authToken': 'stored' })
+  })
+
+  await t.test('is not asked below the key a stored token was found under', async t => {
+    reply(t, 'Bearer stored')
+    await fetch.json('/hello', { ...base, '//mock.reg/prefix/:_authToken': 'stored' })
+    t.strictSame(calls, ['//mock.reg/prefix/hello', '//mock.reg/prefix/'])
+  })
+
+  await t.test('a stored token under a longer key wins', async t => {
+    answers['//mock.reg/'] = 'Bearer fromfn'
+    reply(t, 'Bearer stored')
+    await fetch.json('/hello', { ...base, '//mock.reg/prefix/:_authToken': 'stored' })
+  })
+
+  await t.test('a stored token is used when the function has nothing', async t => {
+    reply(t, 'Bearer stored')
+    await fetch.json('/hello', { ...base, '//mock.reg/prefix/:_authToken': 'stored' })
+  })
+
+  await t.test('a tarball on the registry host is matched through the registry keys', async t => {
+    answers['//mock.reg/prefix/'] = 'Bearer fromfn'
+    reply(t, 'Bearer fromfn', '/tarballs/foo.tgz')
+    await fetch('https://mock.reg/tarballs/foo.tgz', base)
+    t.strictSame(calls, [
+      '//mock.reg/tarballs/foo.tgz',
+      '//mock.reg/tarballs/',
+      '//mock.reg/tarballs',
+      '//mock.reg/',
+      '//mock.reg',
+      '//mock.reg/prefix/',
+    ])
+  })
+
+  await t.test('a tarball on another host is not matched through the registry', async t => {
+    answers['//mock.reg/prefix/'] = 'Bearer fromfn'
+    tnock(t, 'https://other.host')
+      .matchHeader('authorization', v => v === undefined)
+      .get('/foo.tgz')
+      .reply(200, 'tgz')
+    await fetch('https://other.host/foo.tgz', base)
+    t.strictSame(calls, ['//other.host/foo.tgz', '//other.host/', '//other.host'])
+  })
+
+  await t.test('is not asked offline or with forceAuth', async t => {
+    tnock(t, 'https://mock.reg')
+      .get('/prefix/hello')
+      .times(3)
+      .reply(200, '"ok"')
+    await fetch.json('/hello', { ...base, forceAuth: { token: 'forced' }, preferOnline: true })
+    await fetch.json('/hello', { ...base, offline: false, preferOnline: true, getAuthorization: undefined })
+    t.strictSame(calls, [])
+    await fetch.json('/hello', { ...base, offline: true })
+    t.strictSame(calls, [])
+  })
+
+  await t.test('an error from the function rejects the request as it is', async t => {
+    const er = new Error('no luck')
+    await t.rejects(fetch('/hello', { ...base,
+      getAuthorization: async () => {
+        throw er
+      } }), er)
+  })
+
+  await t.test('a body that fails while the function runs rejects the request', async t => {
+    const er = new Error('body failed')
+    let release
+    const slow = () => new Promise(resolve => {
+      release = () => resolve('Bearer late')
+    })
+    await t.rejects(fetch('/hello', { ...base, method: 'PUT', getAuthorization: slow, body: Promise.reject(er) }), er)
+    const body = new Minipass()
+    const p = fetch('/hello', { ...base, method: 'PUT', gzip: true, getAuthorization: slow, body })
+    body.emit('error', er)
+    await t.rejects(p, er)
+    release()
+  })
+
+  await t.test('a body that is a stream is sent after the function is done', async t => {
+    tnock(t, 'https://mock.reg')
+      .matchHeader('authorization', v => v[0] === 'Bearer fromfn')
+      .put('/prefix/hello')
+      .reply(200, '"ok"')
+    const body = new Minipass()
+    body.end('hello')
+    const res = await fetch.json('/hello', {
+      ...base,
+      method: 'PUT',
+      gzip: true,
+      body,
+      getAuthorization: async () => 'Bearer fromfn',
+    })
+    t.equal(res, 'ok')
+  })
+})
