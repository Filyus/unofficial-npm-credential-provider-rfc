+    // created); the callback reports that, and nothing may throw past it
+    for (const stream of [child.stdin, child.stdout, child.stderr]) {
+      stream?.on('error', ignore)
+    }
+    // a helper that exited while a background process it started still holds
+    // its stdout would otherwise keep the run open until the deadline, and the
+    // token it printed would be thrown away
+    let drain
+    child.once?.('exit', () => {
+      drain = setTimeout(() => {
+        child.stdout?.destroy()
+        child.stderr?.destroy()
+      }, DRAIN)
+    })
