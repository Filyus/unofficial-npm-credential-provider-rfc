+const ignore = () => {}
+
+// A helper's credential goes only where it cannot be read on the wire: over
+// https:, or over http: to the machine itself, which local registries use. A
+// stored token has no such rule (its key carries no scheme), so this is
+// stricter, and the credential is new. WHATWG URL writes an IPv6 host with its
+// brackets.
