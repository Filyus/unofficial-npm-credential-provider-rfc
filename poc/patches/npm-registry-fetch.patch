+  const helper = makeHelper(t, print('s3cret'))
+  const { fetch: recorded, calls } = recording(t)
+  await recorded.json('/pkg', {
+    ...OPTS, ...PROJECT, tokenHelperTransport: TRANSPORT, tokenHelpers: { [REG_KEY]: helper },
+  })
+  t.equal(calls.length, 1)
+  t.equal(calls[0].headers.authorization, 'Bearer s3cret')
+  t.same(transportOf(calls[0]), {
+    proxy: TRANSPORT.httpsProxy,
+    noProxy: TRANSPORT.noProxy,
+    ca: TRANSPORT.ca,
+    strictSSL: true,
+    localAddress: TRANSPORT.localAddress,
