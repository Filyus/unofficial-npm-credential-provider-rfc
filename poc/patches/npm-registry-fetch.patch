@@ -3,6 +3,7 @@
 const { HttpErrorAuthOTP } = require('./errors.js')
 const checkResponse = require('./check-response.js')
 const getAuth = require('./auth.js')
+const getTokenHelperHeader = require('./token-helper.js')
 const fetch = require('make-fetch-happen')
 const JSONStream = require('./json-stream')
 const npa = require('npm-package-arg')
@@ -71,12 +72,8 @@ function regFetch (uri, /* istanbul ignore next */ opts_ = {}) {
 
   if (opts.gzip) {
     headers['content-encoding'] = 'gzip'
-    if (bodyIsStream) {
-      const gz = new zlib.Gzip()
-      body.on('error', /* istanbul ignore next: unlikely and hard to test */
-        err => gz.emit('error', err))
-      body = body.pipe(gz)
-    } else if (!bodyIsPromise) {
+    // a stream is piped into gzip only when the request is about to be sent
+    if (!bodyIsStream && !bodyIsPromise) {
       body = new zlib.Gzip().end(body).concat()
     }
   }
@@ -164,7 +161,55 @@ function regFetch (uri, /* istanbul ignore next */ opts_ = {}) {
     }
   }
 
-  return Promise.resolve(body).then(doFetch)
+  const send = () => {
+    if (opts.gzip && bodyIsStream) {
+      const gz = new zlib.Gzip()
+      body.on('error', /* istanbul ignore next: unlikely and hard to test */
+        err => gz.emit('error', err))
+      body = body.pipe(gz)
+    }
+    return Promise.resolve(body).then(doFetch)
+  }
+
+  // an offline request makes no network request, so there is nothing to
+  // authenticate and the helper is not run
+  if (auth.tokenHelper && !opts.offline) {
+    return getHelperHeader(auth, body, opts.signal).then(authorization => {
+      headers.authorization = authorization
+      return send()
+    })
+  }
+  return send()
+}
+
+// The helper can take a while (a login prompt, a network call) and the request
+// is not sent until it is done. Whatever the caller handed over in the
+// meantime has to be watched, or its failure goes unhandled: a body promise
+// that rejects is an unhandled rejection, and a stream that errors with no
+// listener (the gzip pipeline is built after the wait for this reason) throws.
+// The abort signal ends the wait, not the helper: its result is cached and
+// other requests may be waiting for the same run.
+function getHelperHeader (auth, body, signal) {
+  let onAbort
+  const failed = new Promise((resolve, reject) => {
+    if (Minipass.isStream(body)) {
+      body.on('error', reject)
+    } else if (body && typeof body.then === 'function') {
+      Promise.resolve(body).catch(reject)
+    }
+    if (signal) {
+      onAbort = () => reject(signal.reason)
+      if (signal.aborted) {
+        onAbort()
+      } else {
+        signal.addEventListener('abort', onAbort, { once: true })
+      }
+    }
+  })
+  // an aborted request does not need the helper to run
+  const header = signal?.aborted ? failed : getTokenHelperHeader(auth.tokenHelper, auth.regKey)
+  // the signal may be shared by many requests and outlive this one
+  return Promise.race([header, failed]).finally(() => signal?.removeEventListener('abort', onAbort))
 }
 
 module.exports.getAuth = getAuth
diff --git a/lib/token-helper.js b/lib/token-helper.js
new file mode 100644
index 0000000..e22fb4a
--- /dev/null
+++ b/lib/token-helper.js
@@ -0,0 +1,378 @@
+'use strict'
+
+const { execFile } = require('child_process')
+const fs = require('fs')
+const path = require('path')
+const { log } = require('proc-log')
+
+// A token helper is an executable that prints a registry credential to stdout.
+// The semantics match pnpm's `tokenHelper`, so one helper serves both clients:
+// a raw token is sent as a Bearer token, and output that already starts with
+// an auth scheme (`Bearer ...`, `Basic ...`) is used as the header value.
+// Restricting the setting to user and global config is the config layer's
+// job; this module only refuses anything that is not an absolute path.
+
+const TIMEOUT = 60 * 1000
+// how long a helper that ignores SIGTERM gets before it is killed outright
+const GRACE = 2 * 1000
+const MAX_BUFFER = 1024 * 1024
+// how long stdout and stderr may still deliver after the helper has exited:
+// a background process it started can hold them open indefinitely
+const DRAIN = 250
+// the longest working directory Windows starts a program in
+const MAX_WIN_CWD = 258
+
+// At most one run per helper and registry for the life of the process, and a
+// failed run counts: it is cached like a success, so a broken helper is not
+// started again for every request of an install.
+const cache = new Map()
+
+class TokenHelperError extends Error {
+  // `cause` is limited to a code and a signal by the callers: the errors
+  // execFile produces carry the helper's stdout, stderr and command line, and
+  // stdout is the credential
+  constructor (helper, message, cause) {
+    super(`Token helper ${JSON.stringify(helper)} ${message}`, { cause })
+    this.code = 'ETOKENHELPER'
+    this.helper = helper
+  }
+}
+
+// What the helper printed, without the whitespace around it. trim() also
+// removes a leading U+FEFF, which Windows PowerShell 5.1 puts in front of
+// UTF-8 output; a leading space would otherwise turn into `Bearer  tok`.
+const clean = (stdout) => stdout.trim()
+
+const toHeader = (helper, stdout) => {
+  const token = clean(stdout)
+  if (!token) {
+    throw new TokenHelperError(helper, 'printed an empty token')
+  }
+  // a second line, a control character or anything outside ASCII would make
+  // Headers throw an error that quotes the whole value, credential included,
+  // and npm prints and logs that error; refused here without quoting it
+  if (/[^\t\x20-\x7e]/.test(token)) {
+    throw new TokenHelperError(helper, 'printed something that is not a valid header value ' +
+      '(more than one line, a control character or a non-ASCII character)')
+  }
+  return /^[A-Za-z]+ /.test(token) ? token : `Bearer ${token}`
+}
+
+// Why execFile failed, in words for the user. `err.message` is used only for
+// failures to start, where it is "spawn <path> ENOENT" and never contains
+// output; for a non-zero exit it is "Command failed: <path>\n<stderr>".
+const reason = (err) => {
+  if (err.signal) {
+    return `was killed by ${err.signal}`
+  }
+  if (typeof err.code === 'number') {
+    return `exited with status ${err.code}`
+  }
+  return `could not be run: ${err.message}`
+}
+
+// A script whose #! interpreter is missing fails to start with ENOENT, the
+// same as a helper that is not there: CRLF line endings make it look for
+// `/bin/sh\r`, and `#!/usr/local/bin/node` misses a Homebrew node in
+// /opt/homebrew. Only the #! line is read, never anything the helper printed.
+const interpreter = (helper) => {
+  let line
+  let fd
+  try {
+    fd = fs.openSync(helper, 'r')
+    const head = Buffer.alloc(256)
+    line = head.subarray(0, fs.readSync(fd, head, 0, 256, 0)).toString().split('\n')[0]
+  } catch {
+    return null
+  } finally {
+    if (fd !== undefined) {
+      fs.closeSync(fd)
+    }
+  }
+  if (!line.startsWith('#!')) {
+    return null
+  }
+  return `could not be run: its interpreter ${JSON.stringify(line.slice(2).trim())} was not found` +
+    (line.endsWith('\r') ? ' (the #! line ends in a carriage return: the file has Windows line endings)' : '')
+}
+
+const failure = (helper, err) => new TokenHelperError(helper,
+  (err.code === 'ENOENT' && interpreter(helper)) || reason(err), {
+    code: err.code,
+    signal: err.signal,
+  })
+
+// stderr is the helper's channel to the user, but a helper that fails or runs
+// with `set -x` is likely to echo the credential it handles. Two layers mask it.
+//
+// scrub() removes the helper's own token wherever it appears, in any form
+// (raw, in JSON, on the line after `Authorization:`): it is the one value that
+// is known exactly. It runs on the whole of stderr, before the lines are split,
+// and also covers the part after a scheme, so `Bearer tok` hides `tok` too.
+// Output that is refused (a second line, an ANSI reset, a NUL, an accented or
+// invalid byte next to the token) never appears whole in stderr, so each
+// longer run of printable ASCII in it is hidden as well.
+const scrub = (text, stdout) => {
+  const token = clean(stdout)
+  // eslint-disable-next-line no-control-regex
+  const runs = token.replace(/\x1b\[[0-9;]*[A-Za-z]/g, ' ').split(/[^\x21-\x7e]+/).filter(r => r.length >= 8)
+  for (const secret of [token, token.replace(/^[A-Za-z]+\s+/, ''), ...runs]) {
+    if (secret) {
+      text = text.split(secret).join('***')
+    }
+  }
+  return text
+}
+
+// mask() hides credentials the helper did not print but may be echoing, such
+// as the one it fetched from somewhere else: `key: value` and `key=value` pairs
+// for the usual key names, wherever the key is part of a longer name (JSON
+// `"authorizationToken":"..."`, `NPM_TOKEN=...`), and `Bearer|Basic|Token
+// <value>`. A value that starts a `Bearer <value>` is left to the second
+// pattern, which does not take a lone `=` or `:` for the value.
+const mask = (line) => line
+  .replace(/(authorization|token|password|secret)(["']?\s*[:=]\s*["']?)(?!(?:Bearer|Basic|Token)\s)[^\s"',}]+/gi, '$1$2***')
+  // schemes as headers write them; matching `token` in any case would hide
+  // ordinary words, as in "the token was refreshed"
+  .replace(/\b(Bearer|bearer|BEARER|Basic|basic|BASIC|Token|TOKEN)\s+(?![:=])\S+/g, '$1 ***')
+
+// .cmd and .bat files cannot be executed without a shell on Windows; this is
+// the one case pnpm runs through one, and the path is absolute and comes from
+// trusted config only. Everything else is executed directly.
+// `/s` makes cmd.exe strip one pair of outer quotes from the command line, so
+// the quoted path is wrapped in a second pair, as Node itself does for
+// `shell: true`; a single pair breaks every path that contains a space.
+// cmd.exe expands %VAR% even inside quotes and a `"` ends the quoting, so a
+// path with either cannot be passed safely and is refused (neither occurs in
+// a path someone created on purpose).
+//
+// Every helper starts in its own directory, never in npm's, which is usually
+// the repository: on Windows a command started by bare name (`node` in a
+// cmd-shim, or anything the helper runs) is looked up in the current
+// directory first, so a repository's node.cmd would run in the helper's
+// place. (npm's directory may also be a UNC path, which cmd.exe refuses.)
+const command = (helper, platform, comSpec = process.env.ComSpec) => {
+  const cwd = (platform === 'win32' ? path.win32 : path.posix).dirname(helper)
+  if (platform === 'win32' && cwd.length > MAX_WIN_CWD) {
+    throw new TokenHelperError(helper,
+      `is in a directory whose path is longer than the ${MAX_WIN_CWD} characters Windows starts a program in`)
+  }
+  if (platform === 'win32' && /\.(cmd|bat)$/i.test(helper)) {
+    if (/["%]/.test(helper)) {
+      throw new TokenHelperError(helper, 'cannot be run through cmd.exe because its path contains " or %')
+    }
+    return {
+      file: comSpec || 'cmd.exe',
+      args: ['/d', '/s', '/c', `""${helper}""`],
+      verbatim: true,
+      cwd,
+    }
+  }
+  return { file: helper, args: [], verbatim: false, cwd }
+}
+
+// npm passes a project's config on to what it starts: as npm_config_*
+// variables, `node-options` as NODE_OPTIONS, which a node-based helper obeys,
+// `editor` as EDITOR, which a helper or a tool it calls may run, and
+// `omit=dev` as NODE_ENV. A repository's .npmrc could then load code into the
+// helper and read the credential it prints, without any script running. The
+// helper is the user's program, not one of the project's, so it gets the
+// environment without anything npm itself sets.
+const NPM_SET =
+  /^(npm_config_.*|node_options|editor|node_env|color|init_cwd|node|npm_execpath|npm_node_execpath|npm_command)$/i
+const helperEnv = (env) =>
+  Object.fromEntries(Object.entries(env).filter(([name]) => !NPM_SET.test(name)))
+
+// Stops a helper that outlived its deadline, or that printed too much. SIGTERM
+// first, so a helper that cleans up can; SIGKILL if it ignores that. Windows
+// has no signals, and the real helper behind a .cmd wrapper is a grandchild of
+// cmd.exe, which terminating cmd.exe alone would leave running, so the whole
+// tree goes while the helper runs; a background process it started and left
+// behind when it exited belongs to no tree any more and is not reached.
+// Elsewhere only the helper process itself is signalled, as in
+// pnpm: reaching its children would mean starting it in a session of its own,
+// which would cost it the terminal a helper may prompt on and the Ctrl-C aimed
+// at npm. A helper script should therefore `exec` the command that does the
+// work.
+const killTree = (child, platform, spawn = execFile, grace = GRACE) => {
+  if (child.exitCode !== null || child.signalCode !== null) {
+    return
+  }
+  if (platform === 'win32') {
+    const taskkill = path.win32.join(process.env.SystemRoot || 'C:\\Windows', 'System32', 'taskkill.exe')
+    try {
+      spawn(taskkill, ['/pid', String(child.pid), '/T', '/F'], { windowsHide: true }, () => {})
+    } catch {
+      child.kill()
+    }
+    return
+  }
+  child.kill('SIGTERM')
+  const timer = setTimeout(() => child.kill('SIGKILL'), grace)
+  child.once('exit', () => clearTimeout(timer))
+}
+
+// The deadline is our own timer, not execFile's `timeout`: that sends one
+// SIGTERM and then waits for the process to close, so a helper that ignores
+// it would leave this promise pending (and cached) forever, and one that
+// prints a token and exits 0 after the deadline would succeed. The promise
+// settles at the deadline whatever the process does, and a result that
+// arrives later is ignored.
+//
+// The output limit is counted here too rather than left to execFile's
+// `maxBuffer`: execFile ends the helper with child.kill(), which on Windows
+// reaches cmd.exe only and leaves the helper behind a .cmd wrapper running,
+// and once cmd.exe is gone taskkill can no longer find the tree. So execFile
+// gets no limit, and an overflow ends the whole tree, stops reading, and
+// settles the promise at that moment.
+const run = (helper, timeout, spawn = execFile, platform = process.platform) =>
+  new Promise((resolve, reject) => {
+    // a path command() refuses throws here, which rejects the promise
+    const { file, args, verbatim, cwd } = command(helper, platform)
+    let child
+    let overflowed = false
+    try {
+      child = spawn(file, args, {
+        cwd,
+        env: helperEnv(process.env),
+        windowsHide: true,
+        windowsVerbatimArguments: verbatim,
+        // bytes, counted as the helper wrote them and decoded once at the end
+        encoding: 'buffer',
+        maxBuffer: Infinity,
+      }, (err, out, errOut) => {
+        clearTimeout(timer)
+        clearTimeout(drain)
+        const [stdout, stderr] = [out, errOut].map(b => b.toString('utf8'))
+        // a flood of up to a megabyte is not shown, line by line, after the
+        // error that reported it, and the token it might echo is not known
+        if (overflowed) {
+          return
+        }
+        // shown the way pnpm shows it; stdout carries the credential and is
+        // never logged. The helper's own token is hidden first, as it can be
+        // anywhere in what a failing helper printed
+        for (const line of scrub(stderr, stdout).split(/\r?\n/)) {
+          if (line.trim()) {
+            log.warn('token-helper', mask(line))
+          }
+        }
+        if (err) {
+          return reject(failure(helper, err))
+        }
+        try {
+          resolve(toHeader(helper, stdout))
+        } catch (er) {
+          reject(er)
+        }
+      })
+    } catch (err) {
+      // synchronous throws: EINVAL, ENOTDIR, ENAMETOOLONG, a NUL byte in the path
+      return reject(failure(helper, err))
+    }
+    // the pipes can fail on their own (ENOTCONN when the process could not be
+    // created); the callback reports that, and nothing may throw past it
+    for (const stream of [child.stdin, child.stdout, child.stderr]) {
+      stream?.on('error', ignore)
+    }
+    // a helper that exited while a background process it started still holds
+    // its stdout would otherwise keep the run open until the deadline, and the
+    // token it printed would be thrown away
+    let drain
+    child.once?.('exit', () => {
+      drain = setTimeout(() => {
+        child.stdout?.destroy()
+        child.stderr?.destroy()
+      }, DRAIN)
+    })
+    for (const name of ['stdout', 'stderr']) {
+      let length = 0
+      child[name]?.on('data', (chunk) => {
+        length += Buffer.byteLength(chunk)
+        if (length > MAX_BUFFER) {
+          overflowed = true
+          clearTimeout(timer)
+          reject(new TokenHelperError(helper, `printed more than ${MAX_BUFFER} bytes to ${name}`, {
+            code: 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER',
+          }))
+          killTree(child, platform)
+          child.stdout?.destroy()
+          child.stderr?.destroy()
+        }
+      })
+    }
+    const timer = setTimeout(() => {
+      reject(new TokenHelperError(helper, `timed out after ${timeout} ms`))
+      killTree(child, platform)
+    }, timeout)
+    // the helper gets no input; a closed stdin keeps one that reads it from
+    // waiting until the timeout. There is none when the process could not be
+    // created at all (EMFILE).
+    child.stdin?.end()
+  })
+
+const ignore = () => {}
+
+const isFile = (name) => {
+  try {
+    return fs.statSync(name).isFile()
+  } catch {
+    return false
+  }
+}
+
+// `aws codeartifact get-authorization-token` is not a path, and neither is
+// `/usr/bin/aws codeartifact ...`; a real path with a space in it is. A path
+// with whitespace in it that does not exist is told apart by what comes before
+// a space: when that is a file (also after a directory with a space in its
+// name) the rest is arguments, otherwise the helper is simply not there.
+const refusal = (helper) => {
+  if (typeof helper !== 'string' || !path.isAbsolute(helper)) {
+    return 'must be an absolute path with no arguments (arguments are not supported)'
+  }
+  if (!/\s/.test(helper)) {
+    return null
+  }
+  // only a path that is not there is told apart; one that cannot be read
+  // (EACCES, or EPERM under macOS privacy protection) is left to spawn, which
+  // reports the real reason
+  try {
+    fs.statSync(helper)
+    return null
+  } catch (er) {
+    if (er.code !== 'ENOENT' && er.code !== 'ENOTDIR') {
+      return null
+    }
+  }
+  for (const space of helper.matchAll(/\s/g)) {
+    if (isFile(helper.slice(0, space.index))) {
+      return 'must be an absolute path with no arguments (arguments are not supported)'
+    }
+  }
+  return 'was not found'
+}
