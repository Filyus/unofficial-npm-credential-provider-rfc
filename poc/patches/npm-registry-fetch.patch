+
+// The helper can take a while (a login prompt, a network call) and the request
+// is not sent until it is done. Whatever the caller handed over in the
+// meantime has to be watched, or its failure goes unhandled: a body promise
+// that rejects is an unhandled rejection, and a stream that errors with no
+// listener (the gzip pipeline is built after the wait for this reason) throws.
+// The abort signal ends the wait, not the helper: its result is cached and
+// other requests may be waiting for the same run.
+function getHelperHeader (auth, body, signal) {
+  let onAbort
+  const failed = new Promise((resolve, reject) => {
+    if (Minipass.isStream(body)) {
+      body.on('error', reject)
+    } else if (body && typeof body.then === 'function') {
+      Promise.resolve(body).catch(reject)
+    }
+    if (signal) {
+      onAbort = () => reject(signal.reason)
+      if (signal.aborted) {
+        onAbort()
+      } else {
+        signal.addEventListener('abort', onAbort, { once: true })
+      }
+    }
+  })
+  // an aborted request does not need the helper to run
+  const header = signal?.aborted ? failed : getTokenHelperHeader(auth.tokenHelper, auth.regKey)
+  // the signal may be shared by many requests and outlive this one
+  return Promise.race([header, failed]).finally(() => signal?.removeEventListener('abort', onAbort))
