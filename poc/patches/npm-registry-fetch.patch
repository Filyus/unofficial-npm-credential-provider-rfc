+const getTokenHelperHeader = (helper, regKey, timeout = TIMEOUT) => {
+  const refused = refusal(helper)
+  if (refused) {
+    return Promise.reject(new TokenHelperError(helper, refused))
+  }
+  const key = `${regKey}\0${helper}`
+  if (!cache.has(key)) {
+    cache.set(key, run(helper, timeout))
+  }
+  return cache.get(key)
+}
