+// What run() logs is mask(line) for each line of scrub(stderr, stdout). The
+// promise: a token of 8 or more characters that the helper printed, whether
+// its output was used or refused, appears in no logged line, however stderr
+// repeats it and whatever surrounds it. (A shorter token is hidden only where
+// the helper's output was used and stderr repeats it exactly.)
+t.test('a printed token never survives into a logged line', async t => {
+  const next = seeded(0x5eed)
+  const pick = (list) => list[Math.floor(next() * list.length)]
+  const tokenChars = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~+/=']
+  const noise = [...tokenChars, ' ', '"', ':', '=', ',', '{', '}', '\t', '\u00e9', '\u200b', '\x1b[0m', '\r\n', '\n']
+  const text = (chars, length) => Array.from({ length }, () => pick(chars)).join('')
+  const printed = [
+    tok => tok, tok => `${tok}\n`, tok => ` \ufeff${tok}\r\n`, tok => `Bearer ${tok}`, tok => `Basic ${tok}`,
+    // refused: not a valid header value
+    tok => `${tok}\u00e9`, tok => `${tok}\0`, tok => `${tok}\x1b[0m`, tok => `${tok}\nexpires soon`,
+    tok => `\u201c${tok}\u201d`, tok => `${tok}\ufffd`,
+  ]
+  const echoed = [
+    tok => tok, tok => `Authorization: Bearer ${tok}`, tok => `{"token":"${tok}"}`, tok => `+ printf %s ${tok}`,
+    tok => `token=${tok}`, tok => `got ${tok}.`, tok => `${tok}${tok}`,
+  ]
+  let cases = 0
+  for (; cases < 3000; cases++) {
+    const token = text(tokenChars, 8 + Math.floor(next() * 40))
+    const stdout = pick(printed)(token)
+    const around = () => text(noise, Math.floor(next() * 30))
+    const stderr = around() + pick(echoed)(token) + around()
+    const logged = scrub(stderr, stdout).split(/\r?\n/).map(mask)
+    if (logged.some(line => line.includes(token))) {
+      t.fail(`case ${cases} leaks: ${JSON.stringify({ stdout, stderr, logged })}`)
+      break
+    }
+  }
+  t.equal(cases, 3000, 'no case leaks')
+})
