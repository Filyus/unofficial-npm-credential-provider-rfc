+
+// mask() hides credentials the helper did not print but may be echoing, such
+// as the one it fetched from somewhere else: `key: value` and `key=value` pairs
+// for the usual key names, wherever the key is part of a longer name (JSON
+// `"authorizationToken":"..."`, `NPM_TOKEN=...`, `x-api-key: ...`,
+// `Credential=`), a `Cookie:` header to the end of the line, `Bearer|Basic|Token
+// <value>`, the rest of an `Authorization:` line that starts with `Digest`, `Negotiate` or `AWS4-HMAC-SHA256` (their
+// parameters are comma-separated, and the secret is not the first of them),
+// and the user information of a URL (`https://user:pass@host`). A value that
+// starts a `Bearer <value>` or one of those schemes is left to the later
+// patterns, which do not take a lone `=` or `:` for the value.
+const mask = (line) => line
+  // not `\S+` before the `@`: it must stop at a `/`, so that an address with a
+  // path is not taken for user information, and it starts at a literal `://` so
+  // that a long run of letters costs one pass
+  .replace(/(:\/\/)[^\s/@]+@/g, '$1***@')
+  // a cookie header carries several pairs, separated by `; `
+  .replace(/(cookie["']?\s*[:=]\s*["']?)[^\s"',}].*$/gi, '$1***')
+  .replace(/(authorization|token|password|secret|api[-_]?key|cookie|credential|signature)(["']?\s*[:=]\s*["']?)(?!(?:Bearer|Basic|Token|Digest|Negotiate|AWS4-HMAC-SHA256)\s)[^\s"',}]+/gi, '$1$2***')
+  .replace(/(authorization["']?\s*[:=]\s*["']?)(Digest|Negotiate|AWS4-HMAC-SHA256)\s+(?![:=]).*$/gi, '$1$2 ***')
+  // schemes as headers write them; matching `token` in any case would hide
+  // ordinary words, as in "the token was refreshed"
+  .replace(/\b(Bearer|bearer|BEARER|Basic|basic|BASIC|Token|TOKEN)\s+(?![:=])\S+/g, '$1 ***')
