+t.test('run ends the helper as soon as a stream overflows', async t => {
+  for (const stream of ['stdout', 'stderr']) {
+    const child = Object.assign(fakeChild(4242), { stdout: fakeStream(), stderr: fakeStream() })
+    let done
+    const promise = run('/h', 60000, (bin, args, opts, cb) => {
+      done = cb
+      t.equal(opts.maxBuffer, Infinity, 'execFile, which would kill cmd.exe alone, has no limit')
+      return child
+    }, 'linux')
+
+    // ENOTCONN on a pipe of a process that could not start; the callback
+    // reports the failure, the pipe's own error must not throw
+    child[stream].emit('error', new Error('read ENOTCONN'))
+    child[stream].emit('data', 'x'.repeat(1024 * 1024))
+    t.same(child.signals, [], `${stream}: the limit itself is allowed`)
+    child[stream].emit('data', 'x')
+    t.same(child.signals, ['SIGTERM'], `${stream}: one byte more ends it`)
+    t.ok(child.stdout.destroyed && child.stderr.destroyed, `${stream}: and nothing more is read`)
+
+    // without waiting for the process: the callback comes after it is gone
+    await t.rejects(promise, {
+      message: new RegExp(`bytes to ${stream}$`),
+      cause: { code: 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER' },
+    })
+    const logs = logsOf(t)
+    done(null, 'tok', '+ curl --data raw-secret https://idp\n'.repeat(3))
+    t.same(logs.filter(l => l[1] === 'token-helper'), [], `${stream}: the flood is not logged afterwards`)
+    child.emit('exit', null, 'SIGTERM')
+  }
+
+  // the limit is in bytes: 600 KiB of two-byte characters is over it
+  const wide = Object.assign(fakeChild(4244), { stdout: fakeStream(), stderr: fakeStream() })
+  const widePromise = run('/h', 60000, () => wide, 'linux')
+  wide.stdout.emit('data', 'é'.repeat(600 * 1024))
+  await t.rejects(widePromise, { message: /bytes to stdout$/ })
+  wide.emit('exit', null, 'SIGTERM')
+
+  // each stream has its own count
+  const child = Object.assign(fakeChild(4243), { stdout: fakeStream(), stderr: fakeStream() })
+  let finish
