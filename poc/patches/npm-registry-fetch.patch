+          }
+        }
+        if (err) {
+          return reject(failure(helper, err))
+        }
+        try {
+          resolve(toHeader(helper, stdout))
+        } catch (er) {
+          reject(er)
+        }
+      })
+    } catch (err) {
+      // synchronous throws: EINVAL, ENOTDIR, ENAMETOOLONG, a NUL byte in the path
+      return reject(failure(helper, err))
+    }
