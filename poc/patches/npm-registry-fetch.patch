+      let length = 0
+      child[name]?.on('data', (chunk) => {
+        length += Buffer.byteLength(chunk)
+        if (length > MAX_BUFFER) {
+          overflowed = true
+          clearTimeout(timer)
+          reject(new TokenHelperError(helper, `printed more than ${MAX_BUFFER} bytes to ${name}`, {
+            code: 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER',
