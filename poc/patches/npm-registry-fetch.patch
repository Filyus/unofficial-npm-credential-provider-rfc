+}
+
+const isFile = (name) => {
+  try {
+    return fs.statSync(name).isFile()
+  } catch {
+    return false
+  }
+}
+
+// `aws codeartifact get-authorization-token` is not a path, and neither is
+// `/usr/bin/aws codeartifact ...`; a real path with a space in it is. A path
+// with whitespace in it that does not exist is told apart by what comes before
+// a space: when that is a file (also after a directory with a space in its
