+// Transport. npm-registry-fetch cannot tell which config file a proxy or a
+// certificate came from; the caller can, and hands over the values of the
+// sources it trusts. The options make-fetch-happen receives are recorded.
+const TRANSPORT = {
+  proxy: 'http://trusted-proxy:3128',
+  httpsProxy: 'http://trusted-https-proxy:3128',
+  noProxy: 'trusted.no.proxy',
+  ca: ['trusted-ca'],
+  strictSSL: true,
+  localAddress: '127.0.0.9',
+}
+const PROJECT = {
+  proxy: 'http://project-proxy:3128',
+  httpsProxy: 'http://project-https-proxy:3128',
+  noProxy: 'project.no.proxy',
+  ca: ['project-ca'],
+  strictSSL: false,
+  localAddress: '10.0.0.1',
+}
+const fakeResponse = (status, body = '{}', headers = {}) => {
+  const { Response } = require('minipass-fetch')
+  const stream = new Minipass()
+  stream.end(body)
+  return new Response(stream, { status, headers: { 'content-type': 'application/json', ...headers } })
+}
+const recording = (t, respond = () => fakeResponse(200)) => {
+  const calls = []
+  const recorded = t.mock('..', {
+    'make-fetch-happen': async (uri, options) => {
+      calls.push({ uri, ...options })
+      return respond(calls.length)
+    },
+  })
+  return { fetch: recorded, calls }
+}
+const transportOf = (o) => ({
+  proxy: o.proxy,
+  noProxy: o.noProxy,
+  ca: o.ca,
+  strictSSL: o.strictSSL,
+  localAddress: o.localAddress,
+})
