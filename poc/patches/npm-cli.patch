+t.test('a child npm keeps distrusting files its parent did not trust', async t => {
+  const helper = process.platform === 'win32' ? 'C:\\tools\\token.cmd' : '/usr/local/bin/token'
+  const key = '//helper.registry/:tokenHelper'
+  const path = outsideProjects(t, {
+    project: { 'package.json': '{}' },
+    home: { '.npmrc': `${key}=${helper}\n` },
+  })
+  const load = async (env) => {
+    const config = new Config({
+      npmPath: `${path}/npm`,
+      env,
+      // what a child sees: the parent's userconfig arrives as an env value
+      argv: [process.execPath, __filename],
+      cwd: `${path}/project`,
+      excludeNpmCwd: true,
+      shorthands,
+      definitions,
+      nerfDarts,
