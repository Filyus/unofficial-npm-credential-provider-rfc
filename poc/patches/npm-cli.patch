+        ...(key ? { tokenHelper: HELPER, tokenHelperRegKey: key } : {}),
+      })
+      if (key) {
+        t.equal(config.find(`${key}:tokenHelper`), 'user', 'metadata names the source entry')
+      }
+    })
+  }
+  await t.test('global helper source', async t => {
+    const { config } = await loadHelperConfig(t, { global: helper })
+    const creds = config.getCredentialsByURI('https://helper.registry/npm/')
+    t.same(creds, { tokenHelper: HELPER, tokenHelperRegKey: root })
+    t.equal(config.find(`${creds.tokenHelperRegKey}:tokenHelper`), 'global')
+  })
+})
