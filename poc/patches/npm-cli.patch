diff --git a/lib/utils/publish-config.js b/lib/utils/publish-config.js
new file mode 100644
index 0000000..ffafd42
--- /dev/null
+++ b/lib/utils/publish-config.js
@@ -0,0 +1,24 @@
+const { log } = require('proc-log')
+
+// The `publishConfig` settings that apply on top of the loaded config. Keys
+// set on the command line win over the manifest, and a `tokenHelper` is
+// dropped: it names a program npm would run, and package.json comes with the
+// repository just as a project .npmrc does.
+const publishConfigOverrides = (manifest, cliFlags, command, warn = true) => {
+  const overrides = {}
+  for (const [key, value] of Object.entries(manifest.publishConfig)) {
+    if (key in cliFlags) {
+      continue
+    }
+    if (/(^|:)tokenHelper$/.test(key)) {
+      if (warn) {
+        log.warn(command, `Ignoring publishConfig "${key}": tokenHelper may only be set in user or global config.`)
+      }
+      continue
+    }
+    overrides[key] = value
+  }
+  return overrides
+}
+
+module.exports = publishConfigOverrides
