+    await t.rejects(npm.flatOptions.getAuthorization({ regKey, uri: loopback }), {
+      code: 'ETOKENHELPER',
+      message: /"proxy" comes from .*\.npmrc.*remove it from the project's \.npmrc or publishConfig/,
+    })
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri }), 'Bearer test-helper-token',
+      'and not for an https request, which a proxy only tunnels')
+  })
+
+  t.test('a proxy on the command line is the user\'s own', async t => {
+    const { npm } = await loadMockNpm(t, { homeDir, prefixDir: projectProxy, config: { proxy: 'http://my-proxy:3128' } })
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri: loopback }), 'Bearer test-helper-token')
+  })
+
+  t.test('plain http', async t => {
+    const { npm } = await loadMockNpm(t, { homeDir })
+    await t.rejects(npm.flatOptions.getAuthorization({ regKey, uri: 'http://helper.example/pkg' }),
+      { code: 'ETOKENHELPER', message: /not sent over plain http to helper\.example; use https/ })
+  })
+
+  t.test('a CA in publishConfig', async t => {
+    const { npm } = await loadMockNpm(t, { homeDir })
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri }), 'Bearer test-helper-token')
+    npm.config.setPublishConfigRoute({ ca: 'project-ca' })
+    await t.rejects(npm.flatOptions.getAuthorization({ regKey, uri }), {
+      code: 'ETOKENHELPER',
+      message: /"ca" comes from the publishConfig of package\.json.*or set it on the command line/,
+    })
+    npm.config.setPublishConfigRoute({})
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri }), 'Bearer test-helper-token', 'and not once it is gone')
+  })
+
+  t.test('a proxy in publishConfig', async t => {
+    const { npm } = await loadMockNpm(t, { homeDir })
+    npm.config.setPublishConfigRoute({ proxy: 'http://project-proxy:3128' })
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri }), 'Bearer test-helper-token', 'not over https')
+    await t.rejects(npm.flatOptions.getAuthorization({ regKey, uri: loopback }),
+      { code: 'ETOKENHELPER', message: /"proxy" comes from the publishConfig/ }, 'over http loopback')
+  })
+
+  t.test('publishConfig and an OIDC token', async t => {
+    const { npm } = await loadMockNpm(t, { homeDir })
+    npm.config.setPublishConfigRoute({ ca: 'project-ca', proxy: 'http://project-proxy:3128' })
+    // as lib/utils/oidc.js puts it
+    npm.config.set(`${regKey}:_authToken`, 'oidc-token', 'cli')
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri }), undefined, 'the helper is not asked, so nothing is refused')
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri: loopback }), undefined)
+  })
+
+  t.test('a token on the command line', async t => {
+    const { npm } = await loadMockNpm(t, { homeDir, config: { '//helper.example/:_authToken': 'cli-token' } })
+    t.equal(await npm.flatOptions.getAuthorization({ regKey, uri }), undefined, 'is used instead of the helper')
+    t.same(npm.config.getCredentialsByURI('https://helper.example/'), { token: 'cli-token' },
+      'and the commands that read the credentials agree')
+  })
+})
