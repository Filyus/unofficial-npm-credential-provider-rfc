+  const project = 'https-proxy=http://project-proxy:3128\nca=project-ca\nstrict-ssl=false\ncafile=<path>/project/ca.pem\n'
+  const parent = await loadHelperConfig(t, { user: keyed, project })
+  const exported = Object.fromEntries(Object.entries(parent.config.env)
+    .filter(([key]) => /^npm_config_(https_proxy|ca|strict_ssl|cafile|token_helper_project_transport)$/.test(key)))
+  t.same(Object.keys(exported).sort(),
