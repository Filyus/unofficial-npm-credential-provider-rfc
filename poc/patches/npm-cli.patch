+// tokenHelper: a program npm runs, so it counts only from the user and global
+// files, and only when project config did not choose them
+const HELPER = process.platform === 'win32' ? 'C:\\tools\\token.cmd' : '/usr/local/bin/token'
+const helperIn = (flat, regKey) => flat.tokenHelpers?.[regKey]
