+const t = require('tap')
+const { resolve } = require('node:path')
+const { readFile } = require('node:fs/promises')
+const Config = require('../lib/index.js')
+const definitions = require('../lib/definitions/index.js')
+
+const fixture = (t, { project = '', user = '', helper = true } = {}) => {
+  const inert = resolve('inert-never-created-helper').replace(/\\/g, '/')
+  const base = t.testdir({
+    home: { '.npmrc': `${helper ? `//route.invalid/:tokenHelper=${inert}\n` : ''}${user}` },
+    project: { 'package.json': '{}', '.npmrc': project },
+    clone: { 'package.json': '{}' },
+    npm: {},
+    node: {},
+  })
+  const load = async (cwd = 'project', env = {}, argv = []) => {
+    const config = new Config({
+      ...definitions,
+      npmPath: resolve(base, 'npm'),
+      execPath: resolve(base, 'node/node'),
+      cwd: resolve(base, cwd),
+      excludeNpmCwd: true,
+      env: { HOME: resolve(base, 'home'), USERPROFILE: resolve(base, 'home'), ...env },
+      argv: [process.execPath, __filename, ...argv],
+    })
+    await config.load()
+    t.ok(config.validate(), 'configuration remains valid')
+    return config
+  }
+  return { load, base, inert }
+}
