+  } catch {
+    return null
+  }
+  const logs = []
+  const logHandler = (...args) => logs.push(args)
+  process.on('log', logHandler)
+  t.teardown(() => process.off('log', logHandler))
+  const config = new Config({
+    npmPath: `${path}/npm`,
+    env: { HOME: join(path, home), ...Object.fromEntries(Object.entries(env).map(([k, v]) => [k, v.replaceAll('<path>', path.replaceAll('\\', '/'))])) },
+    argv: [process.execPath, __filename, ...argv.map(a => a.replaceAll('<path>', path.replaceAll('\\', '/')))],
+    cwd: join(path, 'real'),
