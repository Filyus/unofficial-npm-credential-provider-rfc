+  'the unscoped form names the key for the registry the same file sets, as pnpm 11.4 pins it')
+
+  const unparseable = await warnings('registry=not a url\ntokenHelper=/usr/local/bin/token\n')
+  t.ok(unparseable.warned.some(w => w.includes('with the registry the helper serves')),
+    'an unparseable registry= names nothing')
+
+  const slashless = await warnings('//npm.corp.example:tokenHelper=/usr/local/bin/token\n')
+  t.ok(slashless.warned.some(w => w.includes(
+    'Ignoring user config "//npm.corp.example:tokenHelper": a registry key ends in "/" before the colon; ' +
+    'use "//npm.corp.example/:tokenHelper"')), 'the slashless key, as pnpm documents it, names the key to write')
+  t.notOk(slashless.config.getCredentialsByURI('https://npm.corp.example/').tokenHelper, 'and it never runs')
