+const t = require('tap')
+const fs = require('node:fs/promises')
+const { join } = require('node:path')
+const { load: loadMockNpm } = require('../../fixtures/mock-npm.js')
+
+for (const command of ['login', 'logout']) {
+  t.test(`${command} refuses a helper reached only at an account endpoint`, async t => {
+    const key = '//registry.npmjs.org/-/'
+    const npmrc = `${key}:tokenHelper=/inert/never-created-helper\n` +
+      '//registry.npmjs.org/:_authToken=stored-token\n'
+    let reached = 0
+    const account = async opts => {
+      reached++
+      await opts.getAuthorization({ regKey: key, uri: 'https://registry.npmjs.org/-/user/' })
+      t.fail('account operation must stop before obtaining authorization')
+    }
+    const getAuth = Object.assign(() => ({
+      token: 'stored-token', regKey: '//registry.npmjs.org/', authKey: '_authToken',
+    }), { supportsGetAuthorization: true })
+    const mocks = command === 'login'
+      ? { '{LIB}/utils/auth.js': { login: async (npm, opts) => account(opts) } }
+      : { 'npm-registry-fetch': Object.assign(async (uri, opts) => account(opts), { getAuth }) }
+    const { npm, home } = await loadMockNpm(t, { homeDir: { '.npmrc': npmrc }, mocks })
+    await t.rejects(npm.exec(command, []), {
+      code: 'ETOKENHELPER', message: /cannot be used by npm/,
+    })
+    t.equal(reached, 1, 'the endpoint-specific request reaches the wrapper')
+    t.equal(await fs.readFile(join(home, '.npmrc'), 'utf8'), npmrc, 'no credential file edit')
+  })
+}
