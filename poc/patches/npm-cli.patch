diff --git a/test/lib/utils/token-helper.js b/test/lib/utils/token-helper.js
new file mode 100644
index 0000000..f7c2488
--- /dev/null
+++ b/test/lib/utils/token-helper.js
@@ -0,0 +1,657 @@
+const t = require('tap')
+const { EventEmitter } = require('node:events')
+const { PassThrough } = require('node:stream')
+const { join, dirname } = require('node:path')
+const mockGlobals = require('@npmcli/mock-globals')
+
+const WIN = process.platform === 'win32'
+// the platform whose paths the real file system here understands
+const HOST = WIN ? 'win32' : 'linux'
+const REG = '//helper.registry/'
+const POSIX_HELPER = '/usr/local/bin/token'
+// a file that exists, so that messages show it; nothing here runs it
+const HELPER = process.execPath
+
+const logsOf = (t) => {
+  const logs = []
+  const handler = (level, ...args) => logs.push([level, ...args])
+  process.on('log', handler)
+  t.teardown(() => process.off('log', handler))
+  return logs
+}
+const text = (logs, level) => logs.filter(l => l[0] === level).map(l => l.slice(1).join(' '))
+
+// a process that does what the test says; calls collects what was started
+const fakeSpawn = (script) => {
+  const calls = []
+  const spawn = (file, args, opts) => {
+    const child = new EventEmitter()
+    child.stdout = new PassThrough()
+    child.stderr = new PassThrough()
+    child.pid = 4242
+    child.exitCode = null
+    child.signalCode = null
+    child.kills = []
+    child.kill = (signal) => {
+      child.kills.push(signal)
+      return true
+    }
+    let resolve, reject
+    const promise = new Promise((res, rej) => {
+      resolve = res
+      reject = rej
+    })
+    promise.process = child
+    const call = { file, args, opts, child }
+    calls.push(call)
+    script({
+      call,
+      child,
+      finish: (stdout, stderr = '') => resolve({ code: 0, signal: null, stdout, stderr }),
+      fail: (props) => reject(Object.assign(new Error('command failed'), { stdout: '', stderr: '', ...props })),
+    })
+    return promise
+  }
+  return { spawn, calls }
+}
+
+const load = (t, spawn) => t.mock('../../../lib/utils/token-helper.js', { '@npmcli/promise-spawn': spawn })
+
+const configOf = (tokenHelpers, stored = {}) => ({
+  flat: { tokenHelpers },
+  get: (key) => stored[key],
+})
+
+// the function npm passes to npm-registry-fetch, for one registry
+const setup = (t, script, {
+  helper = HELPER,
+  platform = process.platform,
+  startEnv = {},
+  stored,
+  limits,
+} = {}) => {
+  const { spawn, calls } = fakeSpawn(script)
+  const make = load(t, spawn)
+  const getAuthorization = make(configOf({ [REG]: helper }, stored), startEnv, platform, limits)
+  return { getAuthorization, calls, make }
+}
+
+const printing = (stdout, stderr) => ({ finish }) => finish(stdout, stderr)
+
+t.test('a raw token is sent as a Bearer token, a scheme as it is', async t => {
+  for (const [out, header] of [
+    ['abc123', 'Bearer abc123'],
+    ['  abc123  \n', 'Bearer abc123'],
+    ['\ufeffabc123\r\n', 'Bearer abc123'],
+    ['Bearer abc123', 'Bearer abc123'],
+    ['Basic dXNlcjpwYXNz\n', 'Basic dXNlcjpwYXNz'],
+    ['a\tb', 'Bearer a\tb'],
+    ['eyJhbGciOi.payload.sig', 'Bearer eyJhbGciOi.payload.sig'],
+  ]) {
+    const { getAuthorization } = setup(t, printing(out))
+    t.equal(await getAuthorization({ regKey: REG }), header, JSON.stringify(out))
+  }
+})
+
+t.test('output that is not a header value is refused without quoting it', async t => {
+  for (const [out, what] of [
+    ['', 'printed an empty token'],
+    [' \n', 'printed an empty token'],
+    ['alpha-value\nbeta-value', 'not a valid header value'],
+    ['gamma\u0000value', 'not a valid header value'],
+    ['delta\u00e9value', 'not a valid header value'],
+  ]) {
+    const { getAuthorization } = setup(t, printing(out))
+    await t.rejects(getAuthorization({ regKey: REG }), {
+      code: 'ETOKENHELPER',
+      message: new RegExp(what),
+      helper: JSON.stringify(HELPER),
+      helperExitCode: null,
+      signal: null,
+    }, JSON.stringify(out))
+    await getAuthorization({ regKey: REG }).catch(er => t.notMatch(er.message, /alpha|beta|gamma|delta/, 'the output is not in the message'))
+  }
+})
+
+t.test('the helper has no input, its own directory and its own environment', async t => {
+  const { getAuthorization, calls } = setup(t, printing('tok'))
+  await getAuthorization({ regKey: REG })
+  t.equal(calls.length, 1)
+  const { file, args, opts } = calls[0]
+  t.equal(file, HELPER)
+  t.same(args, [])
+  t.equal(opts.shell, false, 'never through a shell')
+  t.same(opts.stdio, ['ignore', 'pipe', 'pipe'], 'stdin is closed')
+  t.equal(opts.cwd, dirname(HELPER), 'in the directory of the helper')
+  t.equal(opts.windowsHide, true)
+})
+
+t.test('a failure names the helper, carries helperExitCode and signal and never the output', async t => {
+  const logs = logsOf(t)
+  const { getAuthorization } = setup(t, ({ fail }) => fail({ code: 3, signal: null, stdout: 'tok-on-stdout', stderr: 'it broke' }))
+  const er = await getAuthorization({ regKey: REG }).catch(e => e)
+  t.equal(er.code, 'ETOKENHELPER')
+  t.equal(er.helperExitCode, 3)
+  t.equal(er.signal, null)
+  t.equal(er.helper, JSON.stringify(HELPER), 'what is shown of the helper, never the raw value')
+  t.match(er.message, `Token helper ${JSON.stringify(HELPER)} exited with status 3`)
+  for (const field of ['stdout', 'stderr', 'cmd', 'args', 'cause']) {
+    t.notOk(field in er, `no ${field} on the error`)
+  }
+  t.same(text(logs, 'warn'), ['token-helper it broke'], 'stderr is shown as a warning')
+  t.equal(await getAuthorization({ regKey: REG }).catch(e => e), er, 'the failure is cached')
+})
+
+t.test('a signal and a spawn error each say what happened', async t => {
+  const signalled = setup(t, ({ fail }) => fail({ code: null, signal: 'SIGSEGV' }))
+  await t.rejects(signalled.getAuthorization({ regKey: REG }), { signal: 'SIGSEGV', helperExitCode: null, message: /was killed by SIGSEGV/ })
+
+  const noStart = setup(t, ({ fail }) => fail({ code: 'EACCES', message: 'spawn x EACCES' }))
+  await t.rejects(noStart.getAuthorization({ regKey: REG }), { helperExitCode: null, message: /could not be run \(EACCES\): spawn x EACCES/ })
+
+  const thrown = setup(t, () => {
+    throw Object.assign(new Error('The argument contains null bytes'), { code: 'ERR_INVALID_ARG_VALUE' })
+  })
+  await t.rejects(thrown.getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER', message: /could not be run \(ERR_INVALID_ARG_VALUE\): The argument/ })
+
+  const unnamed = setup(t, () => {
+    throw new Error('no code on this one')
+  })
+  await t.rejects(unnamed.getAuthorization({ regKey: REG }), { message: /could not be run: no code on this one$/ })
+})
+
+t.test('values that are not an absolute path with no arguments say what to do', async t => {
+  const dir = t.testdir({
+    script: '#!/bin/sh\n',
+    'dir with space': { script: '#!/bin/sh\n' },
+  })
+  const refused = async (helper, message, platform) => {
+    const { getAuthorization, calls } = setup(t, printing('tok'), { helper, platform })
+    await t.rejects(getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER', message }, String(helper))
+    t.equal(calls.length, 0, 'nothing was started')
+  }
+  const absolute = name => join(dir, name)
+
+  await refused('aws codeartifact get-authorization-token', /put the command in a two-line script/, 'linux')
+  await refused('aws', /must be an absolute path: give the full path of the program/, 'linux')
+  await refused('./relative/token', /must be an absolute path: give the full path/, 'linux')
+  await refused(true, /must be an absolute path: give the full path.*PATH that a project can extend/, 'linux')
+  await refused(`${absolute('script')} --domain x`, /put the command in a two-line script/, HOST)
+  await refused(`${join(absolute('dir with space'), 'script')} --domain x`, /two-line script/, HOST)
+  await refused(`${absolute('missing')} --domain x`, /was not found/, HOST)
+  await refused('C:\\tools\\a"b.cmd', /cannot be run through cmd.exe because its path contains ", % or !/, 'win32')
+  await refused('C:\\tools\\%PATH%.bat', /contains ", % or !.*\.cmd wrapper in a directory without them/, 'win32')
+  await refused('C:\\tools\\hello!.cmd', /contains ", % or !/, 'win32')
+  await refused(`C:\\${'d'.repeat(260)}\\token.cmd`, /longer than 258 characters.*move it to a shorter path/, 'win32')
+
+  t.test('an exclamation mark or a long path is fine where cmd.exe is not involved', async t => {
+    const bang = setup(t, printing('tok'), { helper: 'C:\\tools\\hello!.exe', platform: 'win32' })
+    t.equal(await bang.getAuthorization({ regKey: REG }), 'Bearer tok')
+    const posix = setup(t, printing('tok'), { helper: `/${'d'.repeat(300)}/token`, platform: 'linux' })
+    t.equal(await posix.getAuthorization({ regKey: REG }), 'Bearer tok')
+  })
+
+  t.test('a value that is not an existing file is never shown', async t => {
+    // a base64 token has `/` in it, and starts with one often enough to pass for a path
+    const pasted = '/9j/4AAQSkZJRgABAQAAAQABAAD+AbCdEfGh=='
+    const shown = (er) => `${er.message} ${er.helper} ${JSON.stringify(er)}`
+    const hidden = /configured as "\/\/helper\.registry\/:tokenHelper" \(the value is not shown\)/
+    for (const [helper, message] of [
+      ['npm_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789', /absolute path/],
+      [`${absolute('script')} --token ${pasted}`, /two-line script/],
+      [`${pasted} with args`, /two-line script|was not found/],
+      ['aws', /absolute path/],
+      [7, /absolute path/],
+    ]) {
+      const er = await setup(t, printing('tok'), { helper, platform: HOST }).getAuthorization({ regKey: REG }).catch(e => e)
+      t.match(er.message, hidden, `${helper}: the key is named`)
+      t.match(er.message, message)
+      t.notMatch(shown(er), /9j|AbCd|npm_Ab|--token|aws|\b7\b/, `${helper}: nothing of the value`)
+    }
+    // a pasted token that starts with a slash and is not a file: spawn's own error names the path
+    const spawnFailure = setup(t, ({ fail }) => fail({ code: 'ENOENT', message: `spawn ${pasted} ENOENT` }),
+      { helper: pasted, platform: 'linux' })
+    const er = await spawnFailure.getAuthorization({ regKey: REG }).catch(e => e)
+    t.notMatch(shown(er), /9j/, 'also where spawn is the one that fails')
+    t.match(er.message, hidden)
+
+    const file = await setup(t, printing('tok'), { helper: `${absolute('script')} --domain x`, platform: HOST })
+      .getAuthorization({ regKey: REG }).catch(e => e)
+    t.match(file.message, hidden, 'a file followed by arguments is not a file as a whole')
+    t.notMatch(file.message, /--domain/)
+
+    const failing = setup(t, ({ fail }) => fail({ code: 4 }))
+    const real = await failing.getAuthorization({ regKey: REG }).catch(e => e)
+    t.match(real.message, `Token helper ${JSON.stringify(HELPER)} exited with status 4`, 'an existing file is named')
+  })
+
+  t.test('a refusal is looked up once per registry', async t => {
+    const fs = require('node:fs')
+    let stats = 0
+    const stat = fs.statSync
+    fs.statSync = (...args) => {
+      stats++
+      return stat(...args)
+    }
+    t.teardown(() => {
+      fs.statSync = stat
+    })
+    // a path with a space that does not exist is the one that is looked at
+    const helper = `${absolute('missing dir')}${WIN ? '\\' : '/'}token --x`
+    const { getAuthorization } = setup(t, printing('tok'), { helper, platform: HOST })
+    await t.rejects(getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER' })
+    const first = stats
+    t.ok(first > 0, 'it was looked at')
+    for (let i = 0; i < 5; i++) {
+      await t.rejects(getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER' })
+    }
+    t.equal(stats, first, 'and not again')
+  })
+
+  t.test('a path with a space is a path', async t => {
+    const { getAuthorization, calls } = setup(t, printing('tok'), {
+      helper: join(absolute('dir with space'), 'script'),
+      platform: HOST,
+    })
+    t.equal(await getAuthorization({ regKey: REG }), 'Bearer tok')
+    t.equal(calls.length, 1)
+  })
+
+  t.test('a path that cannot be inspected is left to spawn', async t => {
+    // a NUL byte makes stat throw something other than ENOENT
+    const helper = `${absolute('dir with space')}${WIN ? '\\' : '/'}x\u0000y`
+    const { getAuthorization, calls } = setup(t, printing('tok'), { helper, platform: HOST })
+    await getAuthorization({ regKey: REG })
+    t.equal(calls.length, 1)
+  })
+})
+
+t.test('a Windows .cmd or .bat helper runs through cmd.exe with a quoted path', async t => {
+  mockGlobals(t, { 'process.env': { ComSpec: 'C:\\Windows\\System32\\cmd.exe' } })
+  for (const name of ['C:\\x\\token.cmd', 'D:\\y\\TOKEN.BAT']) {
+    const { getAuthorization, calls } = setup(t, printing('tok'), { helper: name, platform: 'win32' })
+    await getAuthorization({ regKey: REG })
+    t.equal(calls[0].file, `""${name}""`, 'quoted twice, for cmd /s')
+    t.equal(calls[0].opts.shell, 'C:\\Windows\\System32\\cmd.exe')
+    t.same(calls[0].args, [])
+    t.equal(calls[0].opts.cwd, name.slice(0, name.lastIndexOf('\\')))
+  }
+  const exe = setup(t, printing('tok'), { helper: 'C:\\x\\t.exe', platform: 'win32' })
+  await exe.getAuthorization({ regKey: REG })
+  t.equal(exe.calls[0].file, 'C:\\x\\t.exe', 'anything else is started directly')
+  t.equal(exe.calls[0].opts.shell, false)
+})
+
+t.test('a Windows .cmd helper without ComSpec runs through cmd.exe', async t => {
+  mockGlobals(t, { 'process.env.ComSpec': undefined })
+  const { getAuthorization, calls } = setup(t, printing('tok'), { helper: 'C:\\x\\t.cmd', platform: 'win32' })
+  await getAuthorization({ regKey: REG })
+  t.equal(calls[0].opts.shell, 'cmd.exe')
+})
+
+t.test('stderr: the exact token is hidden, control characters go, warn on failure, verbose on success', async t => {
+  const secret = 'tok-0123456789'
+  const stderr = [
+    `fetching ${secret} now`,
+    `Authorization: Bearer ${secret}`,
+    '',
+    '   ',
+    'escape \u001b[31mred\u001b[0m and \u009bC1 and \ttab and \u0007bell',
+    'Token expired',
+    'CRLF line\r',
+  ].join('\n')
+
+  const ok = logsOf(t)
+  const success = setup(t, printing(secret, stderr))
+  t.equal(await success.getAuthorization({ regKey: REG }), `Bearer ${secret}`)
+  t.same(text(ok, 'verbose').filter(l => l.startsWith('token-helper')), [
+    'token-helper fetching *** now',
+    'token-helper Authorization: Bearer ***',
+    'token-helper escape [31mred[0m and C1 and \ttab and bell',
+    'token-helper Token expired',
+    'token-helper CRLF line',
+  ])
+  t.same(text(ok, 'warn'), [], 'nothing is a warning when it worked')
+
+  const bad = logsOf(t)
+  const failing = setup(t, ({ fail }) => fail({ code: 1, signal: null, stdout: secret, stderr }))
+  await t.rejects(failing.getAuthorization({ regKey: REG }), { helperExitCode: 1 })
+  t.equal(text(bad, 'warn').length, 5, 'on failure the same lines are warnings')
+  t.notMatch(text(bad, 'warn').join('\n'), secret)
+
+  const scheme = logsOf(t)
+  const withScheme = setup(t, printing('Bearer part-of-it', 'echo Bearer part-of-it and part-of-it'))
+  await withScheme.getAuthorization({ regKey: REG })
+  t.same(text(scheme, 'verbose').filter(l => l.startsWith('token-helper')), ['token-helper echo *** and ***'],
+    'a scheme is hidden with the token, and so is the token alone')
+
+  const refused = logsOf(t)
+  const empty = setup(t, printing('', 'nothing to say'))
+  await t.rejects(empty.getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER' })
+  t.same(text(refused, 'warn'), ['token-helper nothing to say'], 'a helper whose output is refused failed')
+})
+
+t.test('a failure that never started has no output to show', async t => {
+  const logs = logsOf(t)
+  const { getAuthorization } = setup(t, ({ fail }) => fail({ code: 'ENOENT', stdout: undefined, stderr: undefined }))
+  await t.rejects(getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER' })
+  t.same(text(logs, 'warn'), [])
+})
+
+t.test('one run per registry, and a failure counts', async t => {
+  const logs = logsOf(t)
+  let n = 0
+  const { getAuthorization, calls } = setup(t, ({ finish }) => finish(`tok${++n}`))
+  t.equal(await getAuthorization({ regKey: REG }), 'Bearer tok1')
+  t.equal(await getAuthorization({ regKey: REG }), 'Bearer tok1', 'the second request does not run it again')
+  const ask = () => getAuthorization({ regKey: REG })
+  const both = await Promise.all([ask(), ask()])
+  t.same(both, ['Bearer tok1', 'Bearer tok1'])
+  t.equal(calls.length, 1)
+  t.same(text(logs, 'warn'), [])
+
+  const two = fakeSpawn(({ finish }) => finish('x'))
+  const getTwo = load(t, two.spawn)({ flat: { tokenHelpers: { '//a/': HELPER, '//b/': HELPER } }, get: () => undefined }, {})
+  await Promise.all([getTwo({ regKey: '//a/' }), getTwo({ regKey: '//b/' })])
+  t.equal(two.calls.length, 2, 'each registry runs its own')
+
+  const failing = setup(t, ({ fail }) => fail({ code: 2 }))
+  const first = failing.getAuthorization({ regKey: REG })
+  await t.rejects(first, { helperExitCode: 2 })
+  await t.rejects(failing.getAuthorization({ regKey: REG }), { helperExitCode: 2 })
+  t.equal(failing.calls.length, 1, 'a failure is not retried')
+})
+
+t.test('nothing runs for a registry without a helper, a masked one, or in a helper\'s own npm', async t => {
+  const logs = logsOf(t)
+  const { spawn, calls } = fakeSpawn(printing('tok'))
+  const make = load(t, spawn)
+  t.equal(await make({ flat: {}, get: () => undefined }, {})({ regKey: REG }), undefined, 'no helpers at all')
+  t.equal(await make(configOf({ [REG]: HELPER }), {})({ regKey: '//other.registry/' }), undefined, 'another registry')
+  t.equal(await make(configOf({ [REG]: '' }), {})({ regKey: REG }), undefined, 'an OIDC token in use masks the helper')
+  t.equal(calls.length, 0)
+  t.same(text(logs, 'verbose'), [])
+})
