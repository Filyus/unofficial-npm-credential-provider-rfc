+const loadHelperConfig = async (t, { project = '', user = '', global = '', env = {}, argv = [], files = true, sub = '', link = false, outside = false, inWorkspace = false } = {}) => {
+  const path = t.testdir({
+    home: { '.npmrc': user },
+    prefix: { etc: { npmrc: global } },
+    // files inside the repository, which a checkout can carry
+    project: {
+      'package.json': inWorkspace ? '{"workspaces":["packages/*"]}' : '{}',
+      packages: { a: { 'package.json': '{"name":"a"}' } },
+      'ci.npmrc': sub,
+      sub: { etc: { npmrc: sub } },
+    },
+    // a directory that is in no project
+    outside: { 'x.npmrc': sub },
+    'other.npmrc': `//other.registry/:tokenHelper=${HELPER}\n`,
+  })
+  const logs = []
+  const logHandler = (...args) => logs.push(args)
+  process.on('log', logHandler)
+  t.teardown(() => process.off('log', logHandler))
+  if (link) {
+    try {
+      fs.symlinkSync(join(path, 'project', 'ci.npmrc'), join(path, 'link.npmrc'))
+    } catch {
+      // the test skips itself when there is no link
+    }
+  }
+  const fill = s => s.replaceAll('<path>', path.replaceAll('\\', '/'))
+  if (project !== null) {
+    fs.writeFileSync(join(path, 'project', '.npmrc'), fill(project))
+  }
+  const config = new Config({
+    // outside any project the walk up the tree would end in the repository
+    // that holds these tests, unless it meets npm's own directory first
+    npmPath: outside ? path : `${path}/npm`,
+    env: Object.fromEntries(Object.entries({ HOME: `${path}/home`, ...env }).map(([k, v]) => [k, fill(v)])),
+    argv: [process.execPath, __filename,
+      ...(files ? [`--userconfig=${path}/home/.npmrc`, `--globalconfig=${path}/prefix/etc/npmrc`] : []),
+      ...argv.map(fill)],
+    cwd: `${path}/${outside ? 'outside' : inWorkspace ? 'project/packages/a' : 'project'}`,
+    excludeNpmCwd: true,
+    shorthands,
+    definitions,
