+    return { config, warned }
+  }
+
+  const unscoped = await warnings(`tokenHelper=${process.execPath}\n`)
+  t.ok(unscoped.warned.some(w => w.includes(
+    `Write "//<registry>/:tokenHelper=${process.execPath}" with the registry the helper serves`)),
+  'with no registry= in the file, the unscoped form asks for the registry')
+
+  const pinned = await warnings(`registry=https://npm.corp.example/npm/\ntokenHelper=${process.execPath}\n`)
+  t.ok(pinned.warned.some(w => w.includes(
+    `Write "//npm.corp.example/npm/:tokenHelper=${process.execPath}" instead`)),
+  'the unscoped form names the key for the registry the same file sets, as pnpm 12 pins it')
+
+  const unparseable = await warnings('registry=not a url\ntokenHelper=/usr/local/bin/token\n')
+  t.ok(unparseable.warned.some(w => w.includes('with the registry the helper serves')),
