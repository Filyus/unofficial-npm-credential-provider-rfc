+  for (const [name, project, key] of [
+    ['uppercase CA', 'CA=project-ca\n', 'ca'],
+    ['underscore proxy', 'https_proxy=http://project.invalid:3128\n', 'https-proxy'],
+    ['escaped proxy', 'pro\\${unset?}xy=http://project.invalid:3128\n', 'proxy'],
+    ['escaped name containing comma', 'pro\\${un,set?}xy=http://project.invalid:3128\n', 'proxy'],
+    ['uppercase SSL', 'STRICT_SSL=${UNSET?}false\n', 'strict-ssl'],
+    ['canonical SSL changes type', 'strict-ssl=${UNSET?}false\n', 'strict-ssl'],
+    ['escaped SSL', 'strict-ss\\${unset?}l=${UNSET?}false\n', 'strict-ssl'],
+  ]) {
+    await t.test(name, async t => {
+      const { load, inert } = fixture(t, { project })
+      let config = await load()
+      t.same(routeKeys(config), name === 'canonical SSL changes type' ? ['strict-ssl'] : [],
