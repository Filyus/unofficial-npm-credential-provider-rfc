diff --git a/lib/utils/publish-config.js b/lib/utils/publish-config.js
new file mode 100644
index 0000000..ffafd42
--- /dev/null
+++ b/lib/utils/publish-config.js
@@ -0,0 +1,24 @@
+const { log } = require('proc-log')
+
+// The `publishConfig` settings that apply on top of the loaded config. Keys
+// set on the command line win over the manifest, and a `tokenHelper` is
+// dropped: it names a program npm would run, and package.json comes with the
+// repository just as a project .npmrc does.
+const publishConfigOverrides = (manifest, cliFlags, command, warn = true) => {
+  const overrides = {}
+  for (const [key, value] of Object.entries(manifest.publishConfig)) {
+    if (key in cliFlags) {
+      continue
+    }
+    if (/(^|:)tokenHelper$/.test(key)) {
+      if (warn) {
+        log.warn(command, `Ignoring publishConfig "${key}": tokenHelper may only be set in user or global config.`)
+      }
+      continue
+    }
+    overrides[key] = value
+  }
+  return overrides
+}
+
+module.exports = publishConfigOverrides
diff --git a/lib/utils/token-helper.js b/lib/utils/token-helper.js
new file mode 100644
index 0000000..e1042db
--- /dev/null
+++ b/lib/utils/token-helper.js
@@ -0,0 +1,423 @@
+const fs = require('node:fs')
+const path = require('node:path')
+const promiseSpawn = require('@npmcli/promise-spawn')
+const { log } = require('proc-log')
+
+// A token helper is an executable at an absolute path that prints a registry
+// credential to stdout, run for `//<registry>/:tokenHelper` in user or global
+// config (workspaces/config decides what is trusted). It is the setting of the
+// same name that pnpm has, so one helper serves both: a raw token is sent as a
+// Bearer token, and output that already starts with an auth scheme
+// (`Bearer ...`, `Basic ...`) is used as the header value. npm-registry-fetch
+// has no process code; it asks the function made here, as opts.getAuthorization.
+
+const TIMEOUT = 60 * 1000
+// how long a helper that ignores SIGTERM gets before it is killed outright
+const GRACE = 2 * 1000
+const MAX_BYTES = 1024 * 1024
+// how long stdout and stderr may still deliver after the helper has exited: a
+// background process it started can hold them open indefinitely
+const DRAIN = 250
+// the longest working directory Windows starts a program in
+const MAX_WIN_CWD = 258
+// set for the helper, so that an npm it runs starts no helper of its own
+const GUARD = 'NPM_TOKEN_HELPER'
+
+class TokenHelperError extends Error {
+  // Neither stdout (the credential) nor the command line is put on the error:
+  // npm prints and logs what an error carries. `helperExitCode` and `signal` are
+  // there for the user, and error-message.js shows `signal`. It is not called
+  // `exitCode`: the exit handler would make it npm's own exit status.
+  constructor (helper, message, { helperExitCode = null, signal = null } = {}) {
+    super(`Token helper ${JSON.stringify(helper)} ${message}`)
+    this.code = 'ETOKENHELPER'
+    this.helper = helper
+    this.helperExitCode = helperExitCode
+    this.signal = signal
+  }
+}
+
+// A value that is refused is not known to be a path: it can be a credential
+// pasted into the setting, or a command with its arguments (`aws ... --token
+// abc`), and the message is printed and logged. Only what comes before the
+// first whitespace is shown, and of a word that is not a path (no separator in
+// it) only the start, so that a token pasted whole is not echoed either.
+const display = (value) => {
+  if (typeof value !== 'string') {
+    return `<${typeof value}>`
+  }
+  const word = value.split(/\s/)[0]
+  return /[\\/]/.test(word) || word.length <= 6 ? word : `${word.slice(0, 3)}\u2026`
+}
+
+const ARGUMENTS = 'must be an absolute path with no arguments: put the command in a two-line script ' +
+  '(a shell script, or a .cmd file on Windows) and give the path of the script'
+const BARE_NAME = 'must be an absolute path: give the full path of the program ' +
+  '(a bare name would be looked up on a PATH that a project can extend)'
+const WINDOWS_SCRIPT = 'is a .ps1 or .js file, which Windows does not start directly: ' +
+  'use a .cmd wrapper that starts it and give the path of the wrapper'
+
+const isFile = (name) => {
+  try {
+    return fs.statSync(name).isFile()
+  } catch {
+    return false
+  }
+}
+
+// `aws codeartifact get-authorization-token` is not a path, and neither is
+// `/usr/bin/aws codeartifact ...`; a real path with a space in it is. A path
+// with whitespace in it that does not exist is told apart by what comes before
+// a space: when that is a file (also after a directory with a space in its
+// name) the rest is arguments, otherwise the helper is simply not there.
+// Returns why the value is refused, or null.
+const refusal = (helper, platform) => {
+  const paths = platform === 'win32' ? path.win32 : path.posix
+  if (typeof helper !== 'string' || !paths.isAbsolute(helper)) {
+    return typeof helper === 'string' && /\s/.test(helper) ? ARGUMENTS : BARE_NAME
+  }
+  if (platform === 'win32') {
+    if (/\.(ps1|js)$/i.test(helper)) {
+      return WINDOWS_SCRIPT
+    }
+    if (path.win32.dirname(helper).length > MAX_WIN_CWD) {
+      return `is in a directory whose path is longer than ${MAX_WIN_CWD} characters, ` +
+        'where Windows cannot start a program: move it to a shorter path'
+    }
+    if (/\.(cmd|bat)$/i.test(helper) && /["%!]/.test(helper)) {
+      return 'cannot be run through cmd.exe because its path contains ", % or !, which cmd.exe ' +
+        'would reinterpret: give the path of a .cmd wrapper in a directory without them'
+    }
+  }
+  if (!/\s/.test(helper)) {
+    return null
+  }
+  // only a path that is not there is told apart; one that cannot be read
+  // (EACCES, or EPERM under macOS privacy protection) is left to spawn, which
+  // reports the real reason
+  try {
+    fs.statSync(helper)
+    return null
+  } catch (er) {
+    if (er.code !== 'ENOENT' && er.code !== 'ENOTDIR') {
+      return null
+    }
+  }
+  for (const space of helper.matchAll(/\s/g)) {
+    if (isFile(helper.slice(0, space.index))) {
+      return ARGUMENTS
+    }
+  }
+  return 'was not found'
+}
+
+// What the helper printed, without the whitespace around it. trim() also
+// removes a leading U+FEFF, which Windows PowerShell 5.1 puts in front of UTF-8
+// output; a leading space would otherwise turn into `Bearer  tok`.
+const toHeader = (helper, stdout) => {
+  const token = stdout.trim()
+  if (!token) {
+    throw new TokenHelperError(helper, 'printed an empty token')
+  }
+  // a second line, a control character or anything outside ASCII would make
+  // Headers throw an error that quotes the whole value, credential included,
+  // and npm prints and logs that error; refused here without quoting it
+  if (/[^\t\x20-\x7e]/.test(token)) {
+    throw new TokenHelperError(helper, 'printed something that is not a valid header value ' +
+      '(more than one line, a control character or a non-ASCII character)')
+  }
+  // a scheme as pnpm reads one for a request: ASCII letters and a space
+  return /^[A-Za-z]+ /.test(token) ? token : `Bearer ${token}`
+}
+
+// A script whose #! interpreter is missing fails to start with ENOENT, the
+// same as a helper that is not there: CRLF line endings make it look for
+// `/bin/sh\r`, and `#!/usr/local/bin/node` misses a Homebrew node in
+// /opt/homebrew. Only the #! line is read, never anything the helper printed.
+const interpreter = (helper) => {
+  let line
+  let fd
+  try {
+    fd = fs.openSync(helper, 'r')
+    const head = Buffer.alloc(256)
+    line = head.subarray(0, fs.readSync(fd, head, 0, 256, 0)).toString().split('\n')[0]
+  } catch {
+    return null
+  } finally {
+    if (fd !== undefined) {
+      fs.closeSync(fd)
+    }
+  }
+  if (!line.startsWith('#!')) {
+    return null
+  }
+  return `could not be run: its interpreter ${JSON.stringify(line.slice(2).trim())} was not found` +
+    (line.endsWith('\r') ? ' (the #! line ends in a carriage return: the file has Windows line endings)' : '')
+}
+
+// Why the helper failed, in words for the user. For a failure to start the
+// message of the error is "spawn <path> ENOENT" and never contains output.
+const failure = (helper, err) => {
+  const exitCode = typeof err.code === 'number' ? err.code : null
+  const signal = err.signal || null
+  let reason
+  if (signal) {
+    reason = `was killed by ${signal}`
+  } else if (exitCode === 127 || exitCode === 9009) {
+    // a shell's and cmd.exe's status for a command that was not found
+    reason = `exited with status ${exitCode}, which a shell gives when a command it runs is not found; ` +
+      'npm takes the node_modules/.bin directories it added for a script out of the helper\'s PATH, ' +
+      'so a tool installed in a project has to be called by its absolute path'
+  } else if (exitCode !== null) {
+    reason = `exited with status ${exitCode}`
+  } else {
+    reason = (err.code === 'ENOENT' && interpreter(helper)) || `could not be run: ${err.message}`
+  }
+  return new TokenHelperError(helper, reason, { helperExitCode: exitCode, signal })
+}
+
+// Hides the helper's own token, exactly as it printed it and without the
+// scheme in front of it, wherever it appears in what the helper wrote to
+// stderr; control characters (C0 and C1 but tab) go too, so that a helper that
+// relays a registry's text cannot put escape sequences on the user's terminal.
+// That is all the masking there is: it is for a token echoed by accident, and
+// a helper that encodes its credential on purpose is not stopped and cannot be.
+const shown = (stderr, stdout) => {
+  const token = stdout.trim()
+  const secrets = new Set([token, token.replace(/^[A-Za-z]+\s+/, '')])
+  secrets.delete('')
+  // longest first, so that a secret that contains another is hidden whole
+  for (const secret of [...secrets].sort((a, b) => b.length - a.length)) {
+    stderr = stderr.split(secret).join('***')
+  }
+  return stderr.split(/\r?\n/)
+    .map(line => line.replace(/[^\t\x20-\x7e\xa0-\uffff]/g, ''))
+    .filter(line => line.trim())
+}
+
+// The file and arguments to start. .cmd and .bat cannot be started without
+// cmd.exe on Windows, which is how pnpm runs them too, and
+// @npmcli/promise-spawn quotes for it. `/s` makes cmd.exe strip one pair of
+// outer quotes from the command line, so the path is wrapped in two pairs.
+// Everything else is started directly, never through a shell. A path with `"`
+// or `%` was refused already: cmd.exe expands %VAR% even inside quotes, and a
+// `"` ends the quoting.
+const command = (helper, platform) => platform === 'win32' && /\.(cmd|bat)$/i.test(helper)
+  ? { file: `""${helper}""`, shell: process.env.ComSpec || 'cmd.exe' }
+  : { file: helper, shell: false }
+
+// The helper gets npm's environment without what npm set from a project's
+// config or about itself. A project's .npmrc reaches a child this way:
+// `node-options` alone would let a repository load code into a node-based
+// helper and read the credential it prints. Every npm_config_* variable goes,
+// and the four others, each set only from the config key named: NODE_OPTIONS
+// (`node-options`), EDITOR (`editor`), NODE_ENV (`omit` holding `dev`) and COLOR
+// (`color`). Where npm overwrote a value the user had in the environment npm
+// started with, the helper gets that value back, and where there was none the
+// variable is absent. An npm that was itself started by npm (a script that runs
+// `npm publish`) finds the first two already set from its parent's config,
+// which it exports as npm_config_node_options and npm_config_editor, so a value
+// equal to that is npm's too.
+const RESTORED = /^(node_options|editor|node_env|color)$/i
+const original = (startEnv) => {
+  const lookup = (name) => Object.entries(startEnv).find(([key]) => key.toLowerCase() === name)?.[1]
+  return Object.fromEntries(Object.entries(startEnv).filter(([name, value]) => {
+    const lower = name.toLowerCase()
+    const fromParent = ['node_options', 'editor'].includes(lower) && value === lookup(`npm_config_${lower}`)
+    return RESTORED.test(name) && !fromParent
+  }))
+}
+
+// The directories npm put in front of PATH for a script: when npm runs inside
+// `npm run`, @npmcli/run-script puts each node_modules/.bin from the package
+// up to the root, then its own node-gyp-bin, in front of PATH. A dependency's
+// bin is linked there even when its install scripts never ran (npm 12's
+// default, or --ignore-scripts), so it could be the `aws` a helper script
+// runs. Only what npm added is taken out: that leading block, up to
+// run-script's node-gyp-bin (a nested run repeats it), and the
+// node_modules/.bin of the working directory and its parents, which another
+// package manager's runner puts there. A node_modules/.bin the user put on
+// PATH anywhere else stays.
+const BIN = /[\\/]node_modules[\\/]\.bin[\\/]?$/i
+const RUN_SCRIPT_GYP = /[\\/]@npmcli[\\/]run-script[\\/]lib[\\/]node-gyp-bin[\\/]?$/i
+const withoutScriptPaths = (value, delimiter = path.delimiter, cwd = process.cwd()) => {
+  const paths = delimiter === ';' ? path.win32 : path.posix
+  const key = (entry) => {
+    const resolved = paths.resolve(entry)
+    return paths === path.win32 ? resolved.toLowerCase() : resolved
+  }
+  const ancestors = new Set()
+  for (let dir = paths.resolve(cwd); ; dir = paths.dirname(dir)) {
+    ancestors.add(key(paths.join(dir, 'node_modules', '.bin')))
+    if (paths.dirname(dir) === dir) {
+      break
+    }
+  }
+  const entries = value.split(delimiter)
+  const block = entries.findLastIndex((entry) => RUN_SCRIPT_GYP.test(entry))
+  return entries.filter((entry, i) =>
+    !(i <= block && (BIN.test(entry) || RUN_SCRIPT_GYP.test(entry))) &&
+    !(entry && ancestors.has(key(entry)))).join(delimiter)
+}
+
+const helperEnv = (env, startEnv, delimiter, cwd) => ({
+  ...Object.fromEntries(Object.entries(env)
+    .filter(([name]) => !/^npm_config_/i.test(name) && !RESTORED.test(name))
+    .map(([name, value]) => [name, /^path$/i.test(name) ? withoutScriptPaths(value, delimiter, cwd) : value])),
+  ...original(startEnv),
+  [GUARD]: '1',
+})
+
+// Stops a helper that outlived its deadline, or that printed too much. SIGTERM
+// first, so a helper that cleans up can, and SIGKILL if it ignores that.
+// Windows has no signals, and the helper behind a .cmd wrapper is a grandchild
+// of cmd.exe, which ending cmd.exe alone would leave running, so the whole tree
+// goes there. Elsewhere only the helper process itself is signalled, as in
+// pnpm: reaching its children would mean starting it in a session of its own,
+// which would cost it the terminal a helper may prompt on and the Ctrl-C aimed
+// at npm. A helper script should therefore `exec` the command that does the
+// work.
+const stop = (child, platform, grace) => {
+  if (child.exitCode !== null || child.signalCode !== null) {
+    return
+  }
+  if (platform === 'win32') {
+    const taskkill = path.win32.join(process.env.SystemRoot || 'C:\\Windows', 'System32', 'taskkill.exe')
+    promiseSpawn(taskkill, ['/pid', String(child.pid), '/T', '/F'], { stdio: 'ignore', windowsHide: true })
+      .catch(() => child.kill())
+    return
+  }
+  child.kill('SIGTERM')
+  const timer = setTimeout(() => child.kill('SIGKILL'), grace)
+  child.once('exit', () => clearTimeout(timer))
+}
+
+// The deadline and the size limit are the runner's own: @npmcli/promise-spawn
+// has neither. The promise settles at the moment either is reached, whatever
+// the process does after that (a helper that ignores SIGTERM, or holds its
+// stdout open through a process it started), and what it produces later is
+// ignored.
+const run = (helper, startEnv, platform, { timeout, grace, drain }) =>
+  new Promise((resolve, reject) => {
+    const { file, shell } = command(helper, platform)
+    const cwd = (platform === 'win32' ? path.win32 : path.posix).dirname(helper)
+    let spawned
+    try {
+      spawned = promiseSpawn(file, [], {
+        cwd,
+        env: helperEnv(process.env, startEnv, platform === 'win32' ? ';' : ':', process.cwd()),
+        shell,
+        // stdin is closed at once, so a helper that reads it gets end of input
+        stdio: ['ignore', 'pipe', 'pipe'],
+        windowsHide: true,
+      })
+    } catch (er) {
+    // synchronous throws: EINVAL, ENOTDIR, ENAMETOOLONG, a NUL byte in the path
+      return reject(failure(helper, er))
+    }
+    const child = spawned.process
+    let settled = false
+    let drainTimer
+    const abort = (message) => {
+      settled = true
+      clearTimeout(timer)
+      clearTimeout(drainTimer)
+      reject(new TokenHelperError(helper, message))
+      stop(child, platform, grace)
+      child.stdout?.destroy()
+      child.stderr?.destroy()
+    }
+    for (const name of ['stdout', 'stderr']) {
+      let length = 0
+      child[name]?.on('data', (chunk) => {
+        length += chunk.length
+        if (length > MAX_BYTES) {
+          abort(`printed more than ${MAX_BYTES} bytes to ${name}`)
+        }
+      })
+    }
+    // a helper that exited while a background process it started still holds its
+    // stdout would otherwise keep the run open until the deadline, and the token
+    // it printed would be thrown away: the pipes are read for a moment more, then
+    // closed, which lets the process settle
+    child.once('exit', () => {
+      if (!settled) {
+        drainTimer = setTimeout(() => {
+          child.stdout?.destroy()
+          child.stderr?.destroy()
+        }, drain)
+      }
+    })
+    const timer = setTimeout(() => abort(`did not finish in ${timeout / 1000} seconds`), timeout)
+    // stderr is shown the way pnpm shows it in publish: as warnings when the
+    // helper failed, which is when it is worth reading, and at verbose when it
+    // did not. stdout carries the credential and is never logged.
+    const settle = (stderr, stdout, error, header) => {
+      if (settled) {
+        return
+      }
+      settled = true
+      clearTimeout(timer)
+      clearTimeout(drainTimer)
+      for (const line of shown(stderr, stdout)) {
+        log[error ? 'warn' : 'verbose']('token-helper', line)
+      }
+      return error ? reject(error) : resolve(header)
+    }
+    // settle() never throws and every outcome goes through it
+    // eslint-disable-next-line promise/catch-or-return
+    spawned.then((result) => {
+      try {
+        return settle(result.stderr, result.stdout, null, toHeader(helper, result.stdout))
+      } catch (er) {
+        return settle(result.stderr, result.stdout, er)
+      }
+    }, (err) => settle(err.stderr || '', err.stdout || '', failure(helper, err)))
+  })
+
+// One run per registry and helper for the life of the process, and a failure
+// counts: it is cached like a success, so a broken helper is not started again
+// for every request of an install. The returned function is what npm passes to
+// npm-registry-fetch as opts.getAuthorization.
+module.exports = (
+  config,
+  startEnv = process.env,
+  platform = process.platform,
+  limits = { timeout: TIMEOUT, grace: GRACE, drain: DRAIN }
+) => {
+  const cache = new Map()
+  return async (regKey) => {
+    // read from the config as it is now: an OIDC token in use masks the helper
+    const helper = config.flat.tokenHelpers?.[regKey]
+    if (!helper) {
+      return undefined
+    }
+    if (startEnv[GUARD]) {
+      log.verbose('token-helper', `not running the helper of ${regKey}: this npm was started by a token helper`)
+      return undefined
+    }
+    const refused = refusal(helper, platform)
+    if (refused) {
+      throw new TokenHelperError(display(helper), refused)
+    }
+    const key = `${regKey}\0${helper}`
+    if (!cache.has(key)) {
+      // the helper wins, and the credential stored beside it is ignored
+      const ignored = ['_authToken', '_auth', '_password']
+        .filter(name => config.get(`${regKey}:${name}`))
+      if (ignored.length) {
+        log.warn('token-helper', `${regKey}:tokenHelper is used for ${regKey}; the stored ` +
+          `${ignored.map(name => `"${regKey}:${name}"`).join(' and ')} ` +
+          `${ignored.length > 1 ? 'are' : 'is'} ignored`)
+      }
+      cache.set(key, run(helper, startEnv, platform, limits))
+    }
+    return cache.get(key)
+  }
+}
+
+module.exports.GUARD = GUARD
+module.exports.TIMEOUT = TIMEOUT
+module.exports.GRACE = GRACE
+module.exports.DRAIN = DRAIN
+module.exports.withoutScriptPaths = withoutScriptPaths
