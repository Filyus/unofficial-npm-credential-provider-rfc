+  const trusting = await load(inherited)
+  t.equal(trusting.flat[key], helper, 'an env userconfig is trusted on its own')
+  t.same(trusting.tokenHelperUntrusted, [], 'and nothing is passed on as untrusted')
+
+  const child = await load({ ...inherited, npm_config_token_helper_untrusted: 'user' })
+  t.notOk(child.flat[key], 'but not when the parent marked the user file untrusted')
+  t.same(child.tokenHelperUntrusted, ['user'], 'and the marker is passed on again')
