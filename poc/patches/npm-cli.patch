+    })
+    await config.load()
+    config.logWarnings()
+    t.same(config.getUnknownConfigs('user'), [], 'not collected as unknown, so strict-npmrc does not fail')
+    return { config, warned: logs.filter(l => l[0] === 'warn').map(l => l.join(' ')) }
+  }
+
+  const pinned = await warnings('registry=https://npm.corp.example/npm/\ntokenHelper=/usr/local/bin/token\n')
+  t.ok(pinned.warned.some(w => w.includes(
