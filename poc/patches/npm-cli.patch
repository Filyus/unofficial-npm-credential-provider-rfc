diff --git a/lib/commands/logout.js b/lib/commands/logout.js
index dc5a0df..3046c08 100644
--- a/lib/commands/logout.js
+++ b/lib/commands/logout.js
@@ -1,7 +1,9 @@
 const npmFetch = require('npm-registry-fetch')
 const { getAuth } = npmFetch
 const { log } = require('proc-log')
+const nerfDart = require('@npmcli/config/lib/nerf-dart.js')
 const BaseCommand = require('../base-cmd.js')
+const { display } = require('../utils/token-helper.js')
 
 class Logout extends BaseCommand {
   static description = 'Log out of the registry'
@@ -17,6 +19,27 @@ class Logout extends BaseCommand {
     const regRef = scope ? `${scope}:registry` : 'registry'
     const reg = this.npm.config.get(regRef) || registry
 
+    // A helper hands out credentials on demand, so logging out means removing
+    // the helper setting. A token stored beside it is not in use while the
+    // helper is, and is named rather than revoked: revoking it would send the
+    // helper's credential, and deleting it unasked could lose a token the
+    // user still relies on elsewhere.
+    const { tokenHelper } = this.npm.config.getCredentialsByURI(reg)
+    if (tokenHelper) {
+      const regKey = nerfDart(reg)
+      const helperLevel = this.npm.config.find(`${regKey}:tokenHelper`)
+      const tokenKey = `${regKey}:_authToken`
+      const tokenLevel = this.npm.config.get(tokenKey) && this.npm.config.find(tokenKey)
+      throw Object.assign(new Error(
+        `credentials for ${reg} come from the tokenHelper ${display(tokenHelper, `${regKey}:tokenHelper`)}; ` +
+        `remove "${regKey}:tokenHelper" from your ${helperLevel} config to stop using it` +
+        (tokenLevel
+          ? `. A token is also stored as "${tokenKey}" in your ${tokenLevel} config; ` +
+            'it is not used while the helper is configured and was not revoked'
+          : '')
+      ), { code: 'ETOKENHELPER' })
+    }
+
     const auth = getAuth(reg, this.npm.flatOptions)
 
     const level = this.npm.config.find(`${auth.regKey}:${auth.authKey}`)
