+t.test('the time limit: SIGTERM, then SIGKILL, and the request fails at once', async t => {
+  t.equal(load(t, () => {}).TIMEOUT, 60000, 'a minute')
+  t.equal(load(t, () => {}).GRACE, 2000, 'and 2 seconds to leave')
+  const logs = logsOf(t)
+  const { getAuthorization, calls } = setup(t, ({ child }) => {
+    child.stderr.write('still working')
+  }, { platform: 'linux', helper: POSIX_HELPER, limits: { timeout: 20, grace: 40, drain: 20 } })
+  await t.rejects(getAuthorization({ regKey: REG }), {
+    code: 'ETOKENHELPER',
+    message: /did not finish in 0.02 seconds/,
+  })
+  const { child } = calls[0]
+  t.same(child.kills, ['SIGTERM'])
+  await new Promise(resolve => setTimeout(resolve, 100))
+  t.same(child.kills, ['SIGTERM', 'SIGKILL'], 'SIGKILL when it does not leave')
+  t.same(text(logs, 'warn'), [], 'what it writes after that is not shown')
+
+  const polite = setup(t, () => {}, { platform: 'linux', helper: POSIX_HELPER, limits: { timeout: 20, grace: 40, drain: 20 } })
+  await t.rejects(polite.getAuthorization({ regKey: REG }), { code: 'ETOKENHELPER' })
+  polite.calls[0].child.emit('exit')
+  await new Promise(resolve => setTimeout(resolve, 100))
+  t.same(polite.calls[0].child.kills, ['SIGTERM'], 'and not when it did')
+})
