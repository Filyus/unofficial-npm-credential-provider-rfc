+t.test('a helper that left a process holding its pipes does not keep npm waiting', async t => {
+  t.equal(load(t, () => {}).DRAIN, 250, 'a quarter of a second')
+  const limits = { timeout: 5000, grace: 40, drain: 20 }
+  let end
+  const { getAuthorization, calls } = setup(t, ({ child, finish }) => {
+    child.stdout.write('tok\n')
+    end = () => finish('tok')
+    child.once('exit', () => child.stdout.once('close', end))
+  }, { platform: 'linux', helper: POSIX_HELPER, limits })
+  const promise = getAuthorization({ regKey: REG })
+  calls[0].child.emit('exit')
+  t.equal(await promise, 'Bearer tok', 'what it printed is used')
+  t.ok(calls[0].child.stdout.destroyed && calls[0].child.stderr.destroyed, 'and the pipes are closed')
+
+  const quick = setup(t, ({ child, finish }) => {
+    finish('tok')
+    child.emit('exit')
+  }, { platform: 'linux', helper: POSIX_HELPER, limits })
+  t.equal(await quick.getAuthorization({ regKey: REG }), 'Bearer tok')
+  await new Promise(resolve => setTimeout(resolve, 60))
+  t.notOk(quick.calls[0].child.stdout.destroyed, 'a helper that was already done is left alone')
+})
