+  const cases = [
+    { name: 'parent helper', user: helper, key: root },
+    { name: 'registry without trailing slash', user: helper, uri: 'https://helper.registry/npm', key: root },
+    { name: 'specific helper without registry trailing slash', user: `${scoped}:tokenHelper=${HELPER}`, uri: 'https://helper.registry/npm', key: scoped },
+    { name: 'same-key stored token', user: `${helper}${root}:_authToken=stale`, key: root },
+    { name: 'longer stored token', user: `${helper}${scoped}:_authToken=specific`, creds: { token: 'specific' } },
+    { name: 'slashless longer stored token', user: `${helper}//helper.registry/npm:_authToken=specific`, creds: {} },
+    { name: 'longer stored auth', user: `${helper}${scoped}:_auth=dTpw`, creds: { username: 'u', password: 'p', auth: 'dTpw' } },
+    { name: 'longer stored pair', user: `${helper}${scoped}:username=u\n${scoped}:_password=cA==`, creds: { username: 'u', password: 'p', auth: 'dTpw' } },
+    { name: 'incomplete pair', user: `${helper}${scoped}:username=u`, key: root },
+    { name: 'mTLS only', user: `${helper}${scoped}:certfile=cert\n${scoped}:keyfile=key`, key: root, creds: { certfile: 'cert', keyfile: 'key' } },
+    { name: 'CLI token masks parent helper', user: helper, argv: [`--${root}:_authToken=given`], creds: {} },
+    { name: 'env auth masks parent helper', user: helper, env: { [`npm_config_${root}:_auth`]: 'dTpw' }, creds: {} },
+    { name: 'specific helper wins parent CLI token', user: `${scoped}:tokenHelper=${HELPER}`, argv: [`--${root}:_authToken=given`], key: scoped },
+    { name: 'same-key CLI token', user: `${scoped}:tokenHelper=${HELPER}`, argv: [`--${scoped}:_authToken=given`], creds: { token: 'given' } },
+    { name: 'other port', user: helper, uri: 'https://helper.registry:8443/npm/', creds: {} },
+    { name: 'sibling path', user: `${scoped}:tokenHelper=${HELPER}`, uri: 'https://helper.registry/npm-other/', creds: {} },
+    { name: 'stored-only parent lookup unchanged', user: `${root}:_authToken=stored`, creds: {} },
+  ]
+  for (const { name, user, uri = 'https://helper.registry/npm/', key, creds = {}, ...options } of cases) {
