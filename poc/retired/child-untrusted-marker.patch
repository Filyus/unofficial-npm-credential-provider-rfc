+t.test('a child npm keeps distrusting files its parent did not trust', async t => {
+  const keyed = `//helper.registry/:tokenHelper=${HELPER}\n`
+  const trusting = await loadHelperConfig(t, { user: keyed, env: { npm_config_token_helper_untrusted: '' } })
+  t.equal(helperIn(trusting.config.flat, '//helper.registry/'), HELPER, 'an empty marker distrusts nothing')
+
+  const child = await loadHelperConfig(t, { user: keyed, env: { npm_config_token_helper_untrusted: 'user' } })
+  t.notOk(helperIn(child.config.flat, '//helper.registry/'), 'but not the file the parent marked')
+  t.ok(child.warned.some(w => w.includes('the parent npm process did not trust it')))
+  t.same(child.config.tokenHelperUntrusted, ['user'], 'and the marker is passed on again')
+  t.same(child.config.getUnknownConfigs('env'), [], 'the marker is not unknown config')
+
+  const grandchild = await loadHelperConfig(t, {
+    user: '',
+    global: keyed,
+    env: { npm_config_token_helper_untrusted: 'user,global' },
+  })
+  t.same(grandchild.config.tokenHelperUntrusted, ['user', 'global'],
+    'a marked file is passed on even when its file has no helper any more')
+
+  const nobody = await loadHelperConfig(t, { user: 'save=false\n' })
+  t.same(nobody.config.tokenHelperUntrusted, [], 'a file without a helper is never marked')
+
+  const noProject = await loadHelperConfig(t, { project: null, user: keyed })
+  t.equal(helperIn(noProject.config.flat, '//helper.registry/'), HELPER, 'a project without an .npmrc chose nothing')
+})
