+t.test('a child npm is told which config files the parent did not trust for a token helper', t => {
+  const { definitions, defaults } = mockDefinitions(t)
+  const envConf = Object.create(defaults)
+  const cliConf = Object.create(envConf)
+  const make = (tokenHelperUntrusted, env) => ({
+    env,
+    defaults,
+    definitions,
+    list: [cliConf, envConf],
+    globalPrefix,
+    localPrefix,
+    npmBin,
+    execPath,
+    tokenHelperUntrusted,
+  })
+  const env = { npm_config_token_helper_untrusted: 'stale' }
+  setEnvs(make(['user'], env))
+  t.equal(env.npm_config_token_helper_untrusted, 'user')
+  setEnvs(make(['user', 'global'], env))
+  t.equal(env.npm_config_token_helper_untrusted, 'user,global', 'every untrusted file is passed on')
+  setEnvs(make([], env))
+  t.notOk('npm_config_token_helper_untrusted' in env, 'cleared when every file was trusted')
+  t.end()
+})
+
