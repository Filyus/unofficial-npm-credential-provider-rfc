diff --git a/workspaces/config/lib/set-envs.js b/workspaces/config/lib/set-envs.js
index 12719b5..d3af168 100644
--- a/workspaces/config/lib/set-envs.js
+++ b/workspaces/config/lib/set-envs.js
@@ -93,6 +93,19 @@ const setEnvs = (config) => {
   // TODO this may not be the best away to persist these
   env.npm_config_global_prefix = config.globalPrefix
   env.npm_config_local_prefix = config.localPrefix
+  // The proxy, CA and strict-ssl settings that came from a project .npmrc are
+  // exported above as the user's own values, and a child npm with a token
+  // helper must know to refuse them; nothing is set unless a helper is
+  // configured. Nerf-darted keys (`//host/:_authToken`) are never exported
+  // above (envKey skips keys that start with `/`, `@` or `_`), so a token in a
+  // project file does not reach a child as an environment value that would
+  // beat the helper there.
+  const transport = (config.tokenHelperProjectTransport || []).map(({ key }) => key)
+  if (transport.length) {
+    env.npm_config_token_helper_project_transport = transport.join(',')
+  } else {
+    delete env.npm_config_token_helper_project_transport
+  }
   if (cliConf.editor) {
     env.EDITOR = cliConf.editor
