diff --git a/lib/utils/publish-config.js b/lib/utils/publish-config.js
index ffafd42..118f114 100644
--- a/lib/utils/publish-config.js
+++ b/lib/utils/publish-config.js
@@ -1,4 +1,5 @@
 const { log } = require('proc-log')
+const { display } = require('./token-helper.js')
 
 // The `publishConfig` settings that apply on top of the loaded config. Keys
 // set on the command line win over the manifest, and a `tokenHelper` is
@@ -21,4 +22,51 @@ const publishConfigOverrides = (manifest, cliFlags, command, warn = true) => {
   return overrides
 }
 
+// The settings that choose where a request goes and whom it trusts, which a
+// token helper's credential must not follow when package.json chose them (as
+// it must not when a project .npmrc did, see @npmcli/config).
+const TRANSPORT = ['proxy', 'https-proxy', 'ca', 'cafile', 'strict-ssl']
+
+// The registry key of the token helper that a request to `registry` would run:
+// npm-registry-fetch asks for each key of the URL from the longest up and stops
+// at the first that holds a stored credential, and a credential given on the
+// command line or in the environment is used instead of the helper.
+const helperKey = (config, registry) => {
+  const helpers = config.flat.tokenHelpers || {}
+  const { host, pathname } = new URL(registry)
+  let key = `//${host}${pathname}`
+  while (key.length > '//'.length) {
+    if (helpers[key]) {
+      return config.credentialKeysFromCliOrEnv(key).length ? null : key
+    }
+    if (config.get(`${key}:_authToken`) || config.get(`${key}:_auth`) ||
+      config.get(`${key}:username`) && config.get(`${key}:_password`)) {
+      return null
+    }
+    key = key.replace(/([^/]+|\/)$/, '')
+  }
+  return null
+}
+
+// Refuses, before the helper is run, when the publishConfig that applies (what
+// publishConfigOverrides returned: keys set on the command line are not in it)
+// sets one of those for a registry that has a token helper. It is a refusal
+// and not a dropped key, as for a project .npmrc: the user is told what
+// package.json asks for.
+const refuseProjectRoute = (config, overrides, registry) => {
+  const keys = TRANSPORT.filter(key => key in overrides &&
+    (key === 'strict-ssl' ? overrides[key] === false : overrides[key] !== null && overrides[key] !== undefined))
+  const key = keys.length ? helperKey(config, registry) : null
+  if (key) {
+    throw Object.assign(new Error(
+      `Token helper ${display(config.flat.tokenHelpers[key], `${key}:tokenHelper`)} was not run: its credential ` +
+      'is not sent over a route that a project chose, and package.json sets ' +
+      `${keys.map(k => `"publishConfig.${k}"`).join(', ')}; remove ` +
+      `${keys.length > 1 ? 'them' : 'it'} from publishConfig, or set ${keys.length > 1 ? 'them' : 'it'} ` +
+      'on the command line, which overrides publishConfig'
+    ), { code: 'ETOKENHELPER' })
+  }
+}
+
 module.exports = publishConfigOverrides
+module.exports.refuseProjectRoute = refuseProjectRoute
