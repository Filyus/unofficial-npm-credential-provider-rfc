diff --git a/test/lib/utils/publish-config.js b/test/lib/utils/publish-config.js
index 23452aa..eb1fef2 100644
--- a/test/lib/utils/publish-config.js
+++ b/test/lib/utils/publish-config.js
@@ -24,3 +24,66 @@ t.test('publishConfig overrides', async t => {
   publishConfigOverrides(manifest, {}, 'publish', false)
   t.same(logs, [], 'no warning when asked not to')
 })
+
+// a config as far as the check reads it: token helpers by registry key, stored
+// values, and what the command line or environment gives
+const configFor = ({ helpers = { '//r.example/': '/usr/local/bin/token' }, stored = {}, given = {} } = {}) => ({
+  flat: { tokenHelpers: helpers },
+  get: key => stored[key],
+  credentialKeysFromCliOrEnv: key => given[key] || [],
+})
+
+t.test('a publishConfig route setting is refused for a registry that has a token helper', async t => {
+  const { refuseProjectRoute } = publishConfigOverrides
+  const refused = (overrides, config = configFor(), registry = 'https://r.example/') =>
+    t.throws(() => refuseProjectRoute(config, overrides, registry), { code: 'ETOKENHELPER' }, JSON.stringify(overrides))
+
+  for (const overrides of [
+    { proxy: 'http://p:1' },
+    { 'https-proxy': 'http://p:1' },
+    { ca: 'x' },
+    { cafile: '/repo/ca.pem' },
+    { 'strict-ssl': false },
+  ]) {
+    const [key] = Object.keys(overrides)
+    t.throws(() => refuseProjectRoute(configFor(), overrides, 'https://r.example/'), {
+      code: 'ETOKENHELPER',
+      message: new RegExp(`was not run.*"publishConfig\\.${key}".*remove it from publishConfig, ` +
+        'or set it on the command line, which overrides publishConfig'),
+    }, key)
+  }
+  t.throws(() => refuseProjectRoute(configFor(), { proxy: 'http://p:1', ca: 'x' }, 'https://r.example/'), {
+    message: /"publishConfig\.proxy", "publishConfig\.ca"; remove them from publishConfig, or set them on the command line/,
+  }, 'every setting is named')
+
+  refused({ proxy: 'http://p:1' }, configFor({ helpers: { '//r.example/': '/usr/local/bin/token' } }), 'https://r.example/pkg/')
+  refused({ proxy: 'http://p:1' }, configFor({ helpers: { '//r.example/': '/usr/local/bin/token' } }), 'https://r.example/npm/sub/')
+  t.throws(() => refuseProjectRoute(configFor(), { proxy: 'http://p:1' }, 'https://r.example/'),
+    { message: /Token helper configured as "\/\/r\.example\/:tokenHelper" \(the value is not shown\)/ },
+    'a helper value that is not a file is not printed')
+})
+
+t.test('a publishConfig route setting is allowed where no token helper would run', async t => {
+  const { refuseProjectRoute } = publishConfigOverrides
+  const ok = (name, overrides, config, registry = 'https://r.example/') =>
+    t.doesNotThrow(() => refuseProjectRoute(config, overrides, registry), name)
+
+  ok('no token helper at all', { proxy: 'http://p:1' }, { flat: {}, get: () => undefined })
+  ok('a helper for another registry', { proxy: 'http://p:1' }, configFor(), 'https://other.example/')
+  ok('nothing about the route', { tag: 'next', registry: 'https://r.example/' }, configFor())
+  ok('strict-ssl left on', { 'strict-ssl': true }, configFor())
+  ok('null settings are the default', { proxy: null, ca: null, cafile: undefined }, configFor())
+  ok('a credential given for this run replaces the helper', { proxy: 'http://p:1' },
+    configFor({ given: { '//r.example/': ['//r.example/:_authToken'] } }))
+  ok('a token stored under a longer key is used instead', { proxy: 'http://p:1' },
+    configFor({ helpers: { '//r.example/': '/h' }, stored: { '//r.example/npm/:_authToken': 't' } }),
+    'https://r.example/npm/')
+  ok('so is _auth, or a username and password',
+    { proxy: 'http://p:1' },
+    configFor({ helpers: { '//r.example/': '/h' }, stored: { '//r.example/npm/:_auth': 't' } }), 'https://r.example/npm/')
+  ok('a username and password', { proxy: 'http://p:1' },
+    configFor({ helpers: { '//r.example/': '/h' }, stored: { '//r.example/npm/:username': 'u', '//r.example/npm/:_password': 'p' } }),
+    'https://r.example/npm/')
+  ok('a key set on the command line is not in what applies', publishConfigOverrides(
+    { publishConfig: { proxy: 'http://p:1' } }, { proxy: 'http://mine:1' }, 'publish', false), configFor())
+})
