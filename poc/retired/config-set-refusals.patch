diff --git a/test/lib/commands/config.js b/test/lib/commands/config.js
index 1ab9bba..93b2f0b 100644
--- a/test/lib/commands/config.js
+++ b/test/lib/commands/config.js
@@ -754,3 +754,22 @@ t.test('completion', async t => {
     conf: { argv: { remain: ['config'] } },
   }, ['get', 'set', 'delete', 'ls', 'rm', 'edit', 'fix'], 'and works on partials')
 })
+
+t.test('config set tokenHelper', async t => {
+  const helper = process.platform === 'win32' ? 'C:\\tools\\token.cmd' : '/usr/local/bin/token'
+  t.test('scoped, in user config', async t => {
+    const { npm } = await loadMockNpm(t)
+    await npm.exec('config', ['set', '//npm.corp.example.com/:tokenHelper', helper])
+    t.equal(npm.config.get('//npm.corp.example.com/:tokenHelper', 'user'), helper)
+  })
+  t.test('unscoped is refused with a pointer to the scoped form', async t => {
+    const { npm } = await loadMockNpm(t)
+    await t.rejects(npm.exec('config', ['set', 'tokenHelper', helper]),
+      /`tokenHelper` must be scoped to a registry/)
+  })
+  t.test('project config is refused', async t => {
+    const { npm } = await loadMockNpm(t, { config: { location: 'project' } })
+    await t.rejects(npm.exec('config', ['set', '//npm.corp.example.com/:tokenHelper', helper]),
+      /`tokenHelper` is ignored in project config/)
+  })
+})
