diff --git a/lib/utils/token-helper.js b/lib/utils/token-helper.js
index a902f13..3f1208e 100644
--- a/lib/utils/token-helper.js
+++ b/lib/utils/token-helper.js
@@ -98,6 +98,10 @@ const refusal = (helper, platform) => {
       return `is in a directory whose path is longer than ${MAX_WIN_CWD} characters, ` +
         'where Windows cannot start a program: move it to a shorter path'
     }
+    if (/\.(cmd|bat)$/i.test(helper) && /["%!]/.test(helper)) {
+      return 'cannot be run through cmd.exe because its path contains ", % or !, which cmd.exe ' +
+        'would reinterpret: give the path of a .cmd wrapper in a directory without them'
+    }
   }
   if (!/\s/.test(helper)) {
     return null
@@ -212,7 +216,9 @@ const shown = (stderr, stdout) => {
 // cmd.exe on Windows, which is how pnpm runs them too, and
 // @npmcli/promise-spawn quotes for it. `/s` makes cmd.exe strip one pair of
 // outer quotes from the command line, so the path is wrapped in two pairs.
-// Everything else is started directly, never through a shell.
+// Everything else is started directly, never through a shell. A path with `"`
+// or `%` was refused already: cmd.exe expands %VAR% even inside quotes, and a
+// `"` ends the quoting.
 const command = (helper, platform) => platform === 'win32' && /\.(cmd|bat)$/i.test(helper)
   ? { file: `""${helper}""`, shell: process.env.ComSpec || 'cmd.exe' }
   : { file: helper, shell: false }
