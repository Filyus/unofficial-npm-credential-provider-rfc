--- a/lib/utils/token-helper.js
+++ b/lib/utils/token-helper.js
@@ -191,9 +191,10 @@ const failure = (helper, label, err) => {
 
 // Hides the helper's own token, exactly as it printed it and without the
 // scheme in front of it, wherever it appears in what the helper wrote to
-// stderr. That is all the masking there is: it is for a token echoed by
-// accident, and a helper that encodes its credential on purpose is not stopped
-// and cannot be.
+// stderr; control characters (C0 and C1 but tab) go too, so that a helper that
+// relays a registry's text cannot put escape sequences on the user's terminal.
+// That is all the masking there is: it is for a token echoed by accident, and
+// a helper that encodes its credential on purpose is not stopped and cannot be.
 const shown = (stderr, stdout) => {
   const token = stdout.trim()
   const secrets = new Set([token, token.replace(/^[A-Za-z]+\s+/, '')])
@@ -202,7 +203,9 @@ const shown = (stderr, stdout) => {
   for (const secret of [...secrets].sort((a, b) => b.length - a.length)) {
     stderr = stderr.split(secret).join('***')
   }
-  return stderr.split(/\r?\n/).filter(line => line.trim())
+  return stderr.split(/\r?\n/)
+    .map(line => line.replace(/[^\t\x20-\x7e\xa0-\uffff]/g, ''))
+    .filter(line => line.trim())
 }
 
