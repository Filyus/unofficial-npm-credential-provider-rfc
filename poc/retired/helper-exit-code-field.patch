-  // npm prints and logs what an error carries. `signal` is there for the user,
-  // and error-message.js shows it. The exit status of the helper is in the
-  // message, not in a field called `exitCode`: the exit handler would make it
-  // npm's own exit status.
-  constructor (helper, message, { signal = null } = {}) {
+  // npm prints and logs what an error carries. `helperExitCode` and `signal` are
+  // there for the user, and error-message.js shows `signal`. It is not called
+  // `exitCode`: the exit handler would make it npm's own exit status.
+  constructor (helper, message, { helperExitCode = null, signal = null } = {}) {
     super(`Token helper ${helper} ${message}`)
     this.code = 'ETOKENHELPER'
     this.helper = helper
+    this.helperExitCode = helperExitCode
     this.signal = signal
   }
 }
